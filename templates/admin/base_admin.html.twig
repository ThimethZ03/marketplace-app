<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Panel - Marketplace{% endblock %}</title>

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
        <style>
            body {
                background-color: #f5f7fa;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            }
            .sidebar {
                width: 250px;
                min-height: 100vh;
                background-color: #fff;
                border-right: 1px solid #e5e7eb;
                position: fixed;
                top: 0;
                left: 0;
                z-index: 1000;
                transition: transform 0.3s ease;
                overflow-y: auto;
            }
            .sidebar .nav-link {
                color: #6b7280;
                border-radius: 0.5rem;
                margin-bottom: 0.5rem;
                transition: all 0.2s;
            }
            .sidebar .nav-link:hover {
                background-color: #f3f4f6;
                color: #111827;
            }
            .sidebar .nav-link.active {
                background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
                color: white;
            }
            .stat-card {
                border: none;
                border-radius: 0.75rem;
                transition: transform 0.2s;
            }
            .stat-card:hover {
                transform: translateY(-2px);
            }

            .main-content {
                margin-left: 250px;
                width: calc(100% - 250px);
                min-height: 100vh;
            }

            .mobile-toggle {
                display: none;
            }

            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0, 0, 0, 0.5);
                z-index: 999;
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            /* ========================================
               MOBILE RESPONSIVE
               ======================================== */

            /* Tablet (992px and below) */
            @media (max-width: 991.98px) {
                .sidebar {
                    transform: translateX(-100%);
                }

                .sidebar.show {
                    transform: translateX(0);
                }

                .sidebar-overlay.show {
                    display: block;
                    opacity: 1;
                }

                .main-content {
                    margin-left: 0;
                    width: 100%;
                }

                .mobile-toggle {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    position: fixed;
                    top: 1rem;
                    left: 1rem;
                    z-index: 1001;
                    background: white;
                    border: 1px solid #e5e7eb;
                    border-radius: 0.5rem;
                    padding: 0.5rem 0.75rem;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                    cursor: pointer;
                }

                .mobile-toggle:hover {
                    background: #f9fafb;
                }

                .mobile-toggle:active {
                    transform: scale(0.95);
                }

                /* Alert messages */
                .alert {
                    margin: 1rem !important;
                    font-size: 0.9rem;
                }
            }

            /* Tablet/Phone (768px and below) */
            @media (max-width: 767.98px) {
                .alert {
                    margin: 0.75rem !important;
                    font-size: 0.85rem;
                    padding: 0.75rem 1rem;
                }

                .alert .btn-close {
                    font-size: 0.8rem;
                }
            }

            /* Phone (576px and below) */
            @media (max-width: 575.98px) {
                .mobile-toggle {
                    top: 0.75rem;
                    left: 0.75rem;
                    padding: 0.4rem 0.6rem;
                }

                .mobile-toggle i {
                    font-size: 1.3rem;
                }

                .alert {
                    margin: 0.5rem !important;
                    font-size: 0.8rem;
                    padding: 0.625rem 0.875rem;
                    border-radius: 0.375rem;
                }

                .alert .btn-close {
                    font-size: 0.75rem;
                    padding: 0.25rem;
                }

                /* Sidebar adjustments */
                .sidebar {
                    width: 280px;
                }

                .sidebar .p-3 {
                    padding: 1.25rem !important;
                }

                .sidebar .text-center {
                    margin-bottom: 1.25rem !important;
                }

                .sidebar .text-center > div {
                    width: 55px !important;
                    height: 55px !important;
                    margin-bottom: 0.75rem !important;
                }

                .sidebar .text-center i {
                    font-size: 1.4rem !important;
                }

                .sidebar .text-center h5 {
                    font-size: 1.1rem;
                    margin-bottom: 0.25rem !important;
                }

                .sidebar .text-center small {
                    font-size: 0.85rem;
                }

                .sidebar .nav-link {
                    font-size: 0.9rem;
                    padding: 0.625rem 0.75rem;
                    margin-bottom: 0.375rem !important;
                }

                .sidebar .nav-link i {
                    font-size: 0.95rem;
                }

                .sidebar .btn-outline-danger {
                    font-size: 0.9rem;
                    padding: 0.625rem 0.75rem;
                }

                .sidebar .btn-outline-danger i {
                    font-size: 0.95rem;
                }
            }

            /* Very Small Phone (400px and below) */
            @media (max-width: 399.98px) {
                .mobile-toggle {
                    top: 0.625rem;
                    left: 0.625rem;
                    padding: 0.375rem 0.55rem;
                }

                .mobile-toggle i {
                    font-size: 1.2rem;
                }

                .sidebar {
                    width: 260px;
                }

                .sidebar .p-3 {
                    padding: 1rem !important;
                }

                .sidebar .text-center > div {
                    width: 50px !important;
                    height: 50px !important;
                }

                .sidebar .text-center i {
                    font-size: 1.3rem !important;
                }

                .sidebar .text-center h5 {
                    font-size: 1rem;
                }

                .sidebar .text-center small {
                    font-size: 0.8rem;
                }

                .sidebar .nav-link {
                    font-size: 0.85rem;
                    padding: 0.5rem 0.625rem;
                }

                .sidebar .btn-outline-danger {
                    font-size: 0.85rem;
                    padding: 0.5rem 0.625rem;
                }

                .alert {
                    margin: 0.5rem !important;
                    font-size: 0.75rem;
                    padding: 0.5rem 0.75rem;
                }
            }

            /* Landscape phones */
            @media (max-height: 500px) and (orientation: landscape) {
                .sidebar {
                    max-height: 100vh;
                }

                .sidebar .text-center {
                    margin-bottom: 1rem !important;
                }

                .sidebar .text-center > div {
                    width: 45px !important;
                    height: 45px !important;
                    margin-bottom: 0.5rem !important;
                }

                .sidebar .text-center i {
                    font-size: 1.2rem !important;
                }

                .sidebar .text-center h5 {
                    font-size: 0.95rem;
                }

                .sidebar .text-center small {
                    font-size: 0.75rem;
                }

                .sidebar .nav-link {
                    padding: 0.5rem 0.625rem;
                    margin-bottom: 0.25rem !important;
                }
            }
        </style>
    {% endblock %}
</head>
<body>
    <!-- Mobile Menu Toggle -->
    <button class="mobile-toggle btn" onclick="toggleSidebar()" aria-label="Toggle Menu">
        <i class="bi bi-list" style="font-size: 1.5rem;"></i>
    </button>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <div class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar d-flex flex-column p-3" id="sidebar">
            <!-- Logo -->
            <div class="text-center mb-4">
                <div class="d-flex align-items-center justify-content-center rounded-3 mb-2 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                    <i class="bi bi-crown-fill text-white" style="font-size: 1.5rem;"></i>
                </div>
                <h5 class="fw-bold mb-0">Admin</h5>
                <small class="text-muted">Control Panel</small>
            </div>

            <!-- Navigation -->
            <nav class="flex-grow-1">
                <a href="{{ path('app_admin_users') }}" class="nav-link {% if app.request.get('_route') == 'app_admin_users' %}active{% endif %}">
                    <i class="bi bi-people me-2"></i>Manage Users
                </a>
                <a href="{{ path('app_admin_moderators') }}" class="nav-link {% if app.request.get('_route') == 'app_admin_moderators' %}active{% endif %}">
                    <i class="bi bi-shield-check me-2"></i>Moderator Actions
                </a>
            </nav>

            <!-- Logout -->
            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger w-100">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
            </a>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 main-content">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </div>

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            function toggleSidebar() {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.querySelector('.sidebar-overlay');
                sidebar.classList.toggle('show');
                overlay.classList.toggle('show');
            }

            // Close sidebar when clicking nav links on mobile
            document.addEventListener('DOMContentLoaded', function() {
                const navLinks = document.querySelectorAll('.sidebar .nav-link');
                navLinks.forEach(link => {
                    link.addEventListener('click', function() {
                        if (window.innerWidth <= 991.98) {
                            toggleSidebar();
                        }
                    });
                });

                // Close sidebar on escape key
                document.addEventListener('keydown', function(event) {
                    if (event.key === 'Escape') {
                        const sidebar = document.getElementById('sidebar');
                        const overlay = document.querySelector('.sidebar-overlay');
                        if (sidebar.classList.contains('show')) {
                            sidebar.classList.remove('show');
                            overlay.classList.remove('show');
                        }
                    }
                });
            });
        </script>
    {% endblock %}
</body>
</html>

<div class="bg-white border-end h-100 d-flex flex-column" style="width: 250px;">
    <div class="p-4 flex-grow-1">
        <div class="d-flex align-items-center mb-4">
            <div class="bg-primary rounded-3 p-2 me-2">
                <i class="bi bi-shop text-white"></i>
            </div>
            <h5 class="mb-0 fw-bold">{{ sidebar_title|default('Marketplace') }}</h5>
        </div>
        
        {% if sidebar_subtitle is defined %}
            <p class="text-muted small mb-4">{{ sidebar_subtitle }}</p>
        {% endif %}

        <nav class="nav flex-column">
            {% block sidebar_links %}
                <a class="nav-link text-dark" href="{{ path('app_user_dashboard') }}">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
                <a class="nav-link text-dark" href="{{ path('app_user_adverts') }}">
                    <i class="bi bi-list-ul me-2"></i> My Adverts
                </a>
                <a class="nav-link text-dark" href="{{ path('app_home') }}">
                    <i class="bi bi-house me-2"></i> Marketplace
                </a>
            {% endblock %}
        </nav>
    </div>

    <div class="p-4 border-top">
        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger w-100">
            <i class="bi bi-box-arrow-right me-2"></i> Logout
        </a>
    </div>
</div>

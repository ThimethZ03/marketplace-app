{% extends 'base.html.twig' %}

{% block title %}Advertisement Management - Manager{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background-color: #f5f7fa;
        }
        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #fff;
            border-right: 1px solid #e5e7eb;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: transform 0.3s ease;
            overflow-y: auto;
        }
        .sidebar .nav-link {
            color: #6b7280;
            border-radius: 0.5rem;
            margin-bottom: 0.5rem;
            transition: all 0.2s;
        }
        .sidebar .nav-link:hover {
            background-color: #f3f4f6;
            color: #111827;
        }
        .sidebar .nav-link.active {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            color: white;
        }
        .stat-card {
            border: none;
            border-radius: 0.75rem;
            transition: transform 0.2s;
        }
        .stat-card:hover {
            transform: translateY(-2px);
        }
        .advert-img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 0.5rem;
        }

        .main-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
        }

        .mobile-toggle {
            display: none;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        /* ========================================
           MOBILE RESPONSIVE
           ======================================== */

        /* Tablet (992px and below) */
        @media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
                opacity: 1;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .mobile-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
                position: fixed;
                top: 1rem;
                left: 1rem;
                z-index: 1001;
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 0.5rem;
                padding: 0.5rem 0.75rem;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                cursor: pointer;
            }

            .mobile-toggle:hover {
                background: #f9fafb;
            }

            .mobile-toggle:active {
                transform: scale(0.95);
            }

            .stat-card .card-body {
                padding: 1.25rem !important;
            }

            .stat-card h3 {
                font-size: 1.5rem;
            }

            .stat-card i {
                font-size: 1.5rem !important;
            }

            .header-user-info {
                display: none !important;
            }

            /* Alert messages */
            .alert {
                margin: 1rem !important;
                font-size: 0.9rem;
            }
        }

        /* Tablet/Phone (768px and below) */
        @media (max-width: 767.98px) {
            .main-content .p-4 {
                padding: 1.5rem !important;
            }

            h2 {
                font-size: 1.5rem;
            }

            .stat-card .card-body {
                padding: 1rem !important;
            }

            .stat-card h3 {
                font-size: 1.3rem;
            }

            .stat-card .small {
                font-size: 0.8rem !important;
            }

            .stat-card i {
                font-size: 1.3rem !important;
            }

            .stat-card .rounded-3 {
                padding: 0.75rem !important;
            }

            .card-body.p-4 {
                padding: 1.25rem !important;
            }

            .table {
                font-size: 0.875rem;
            }

            .alert {
                margin: 0.75rem !important;
                font-size: 0.85rem;
                padding: 0.75rem 1rem;
            }

            .alert .btn-close {
                font-size: 0.8rem;
            }

            /* Search form */
            .row.g-3 {
                gap: 0.75rem !important;
            }

            .form-select,
            .form-control {
                font-size: 0.9rem;
            }
        }

        /* Phone (576px and below) */
        @media (max-width: 575.98px) {
            .mobile-toggle {
                top: 0.75rem;
                left: 0.75rem;
                padding: 0.4rem 0.6rem;
            }

            .mobile-toggle i {
                font-size: 1.3rem;
            }

            .main-content .p-4 {
                padding: 1rem !important;
                padding-top: 3.5rem !important;
            }

            .d-flex.justify-content-between.align-items-center.mb-4 {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 1rem;
            }

            h2 {
                font-size: 1.3rem;
                margin-bottom: 0.5rem !important;
            }

            .text-muted {
                font-size: 0.85rem;
            }

            /* Stack stat cards */
            .row.g-3.mb-4 {
                gap: 0.75rem !important;
            }

            .stat-card .card-body {
                padding: 0.875rem !important;
                flex-direction: column;
                align-items: flex-start !important;
                gap: 0.75rem;
            }

            .stat-card h3 {
                font-size: 1.2rem;
            }

            .stat-card .small {
                font-size: 0.75rem !important;
            }

            .stat-card i {
                font-size: 1.2rem !important;
            }

            .stat-card .rounded-3 {
                padding: 0.625rem !important;
            }

            /* Search & Filter */
            .card-body.p-4 {
                padding: 1rem !important;
            }

            .row.g-3 {
                gap: 0.75rem !important;
            }

            .col-md-8,
            .col-md-4 {
                width: 100%;
            }

            .form-control,
            .form-select {
                font-size: 0.85rem;
                padding: 0.5rem 0.75rem;
            }

            .input-group-text {
                padding: 0.5rem 0.75rem;
            }

            /* Make table responsive */
            .table-responsive {
                margin: 0;
            }

            .table {
                font-size: 0.8rem;
            }

            .table thead {
                display: none;
            }

            .table tbody tr {
                display: block;
                border: 1px solid #f3f4f6;
                border-radius: 0.5rem;
                margin-bottom: 1rem;
                padding: 1rem;
            }

            .table tbody td {
                display: block;
                text-align: left !important;
                padding: 0.5rem 0 !important;
                border: none !important;
            }

            .table tbody td:first-child {
                padding-top: 0 !important;
                margin-bottom: 0.75rem;
            }

            .table tbody td:last-child {
                padding-bottom: 0 !important;
                margin-top: 0.75rem;
                padding-top: 0.75rem !important;
                border-top: 1px solid #f3f4f6;
            }

            .table tbody td:not(:first-child):not(:last-child)::before {
                content: attr(data-label);
                font-weight: 600;
                display: block;
                margin-bottom: 0.25rem;
                color: #6b7280;
                font-size: 0.75rem;
            }

            .advert-img {
                width: 50px;
                height: 50px;
            }

            .badge {
                font-size: 0.7rem;
            }

            /* Action buttons */
            .table .d-flex.gap-2 {
                justify-content: flex-start !important;
            }

            .table .btn-link i {
                font-size: 1.2rem !important;
            }

            /* Pagination */
            .p-3.border-top {
                padding: 1rem !important;
            }

            .d-flex.justify-content-between.align-items-center {
                flex-direction: column;
                gap: 1rem;
                align-items: stretch !important;
            }

            .d-flex.justify-content-between.align-items-center small {
                font-size: 0.8rem;
                text-align: center;
            }

            .navigation {
                width: 100%;
                text-align: center;
            }

            .pagination {
                font-size: 0.85rem;
                justify-content: center;
            }

            .pagination .page-link {
                padding: 0.4rem 0.65rem;
            }

            .alert {
                margin: 0.5rem !important;
                font-size: 0.8rem;
                padding: 0.625rem 0.875rem;
                border-radius: 0.375rem;
            }

            .alert .btn-close {
                font-size: 0.75rem;
                padding: 0.25rem;
            }

            /* Sidebar adjustments */
            .sidebar {
                width: 280px;
            }

            .sidebar .p-3 {
                padding: 1.25rem !important;
            }

            .sidebar .text-center {
                margin-bottom: 1.25rem !important;
            }

            .sidebar .text-center > div {
                width: 55px !important;
                height: 55px !important;
                margin-bottom: 0.75rem !important;
            }

            .sidebar .text-center i {
                font-size: 1.4rem !important;
            }

            .sidebar .text-center h5 {
                font-size: 1.1rem;
                margin-bottom: 0.25rem !important;
            }

            .sidebar .text-center small {
                font-size: 0.85rem;
            }

            .sidebar .nav-link {
                font-size: 0.9rem;
                padding: 0.625rem 0.75rem;
                margin-bottom: 0.375rem !important;
            }

            .sidebar .nav-link i {
                font-size: 0.95rem;
            }

            .sidebar .btn-outline-danger {
                font-size: 0.9rem;
                padding: 0.625rem 0.75rem;
            }

            .sidebar .btn-outline-danger i {
                font-size: 0.95rem;
            }
        }

        /* Very Small Phone (400px and below) */
        @media (max-width: 399.98px) {
            .mobile-toggle {
                top: 0.625rem;
                left: 0.625rem;
                padding: 0.375rem 0.55rem;
            }

            .mobile-toggle i {
                font-size: 1.2rem;
            }

            h2 {
                font-size: 1.2rem;
            }

            .stat-card h3 {
                font-size: 1.1rem;
            }

            .table {
                font-size: 0.75rem;
            }

            .table tbody tr {
                padding: 0.875rem;
            }

            .advert-img {
                width: 45px;
                height: 45px;
            }

            .form-control,
            .form-select {
                font-size: 0.8rem;
            }

            .pagination {
                font-size: 0.8rem;
            }

            .pagination .page-link {
                padding: 0.35rem 0.55rem;
            }

            .alert {
                margin: 0.5rem !important;
                font-size: 0.75rem;
                padding: 0.5rem 0.75rem;
            }

            .sidebar {
                width: 260px;
            }

            .sidebar .p-3 {
                padding: 1rem !important;
            }

            .sidebar .text-center > div {
                width: 50px !important;
                height: 50px !important;
            }

            .sidebar .text-center i {
                font-size: 1.3rem !important;
            }

            .sidebar .text-center h5 {
                font-size: 1rem;
            }

            .sidebar .text-center small {
                font-size: 0.8rem;
            }

            .sidebar .nav-link {
                font-size: 0.85rem;
                padding: 0.5rem 0.625rem;
            }

            .sidebar .btn-outline-danger {
                font-size: 0.85rem;
                padding: 0.5rem 0.625rem;
            }
        }

        /* Landscape phones */
        @media (max-height: 500px) and (orientation: landscape) {
            .sidebar {
                max-height: 100vh;
            }

            .sidebar .text-center {
                margin-bottom: 1rem !important;
            }

            .sidebar .text-center > div {
                width: 45px !important;
                height: 45px !important;
                margin-bottom: 0.5rem !important;
            }

            .sidebar .text-center i {
                font-size: 1.2rem !important;
            }

            .sidebar .text-center h5 {
                font-size: 0.95rem;
            }

            .sidebar .text-center small {
                font-size: 0.75rem;
            }

            .sidebar .nav-link {
                padding: 0.5rem 0.625rem;
                margin-bottom: 0.25rem !important;
            }
        }

        /* Add data-label attribute styling for mobile */
        @media (max-width: 575.98px) {
            .table tbody td[data-label]::before {
                content: attr(data-label);
            }
        }
    </style>
{% endblock %}

{% block body %}
<!-- Mobile Menu Toggle -->
<button class="mobile-toggle btn" onclick="toggleSidebar()" aria-label="Toggle Menu">
    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
</button>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" onclick="toggleSidebar()"></div>

<div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar d-flex flex-column p-3" id="sidebar">
        <!-- Logo -->
        <div class="text-center mb-4">
            <div class="d-flex align-items-center justify-content-center rounded-3 mb-2 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                <i class="bi bi-shield-check-fill text-white" style="font-size: 1.5rem;"></i>
            </div>
            <h5 class="fw-bold mb-0">AdManager</h5>
            <small class="text-muted">Control Panel</small>
        </div>

        <!-- Navigation -->
        <nav class="flex-grow-1">
            <a href="{{ path('app_manager_dashboard') }}" class="nav-link active">
                <i class="bi bi-megaphone me-2"></i>Manage Ads
            </a>
        </nav>

        <!-- Logout -->
        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger w-100">
            <i class="bi bi-box-arrow-right me-2"></i>Logout
        </a>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 main-content">
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="p-4">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Advertisement Management</h2>
                    <p class="text-muted mb-0">Manage all advertisements</p>
                </div>
                <div class="d-flex align-items-center gap-3 header-user-info">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                        <strong>{{ app.user.initials }}</strong>
                    </div>
                    <div>
                        <div class="fw-semibold">{{ app.user.fullName }}</div>
                        <small class="text-muted">Manager</small>
                    </div>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card stat-card shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center p-4">
                            <div>
                                <p class="text-muted mb-1 small">Total Ads</p>
                                <h3 class="fw-bold mb-0">{{ totalAds|number_format }}</h3>
                            </div>
                            <div class="rounded-3 p-3" style="background-color: #dbeafe;">
                                <i class="bi bi-megaphone-fill" style="font-size: 1.8rem; color: #3b82f6;"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card stat-card shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center p-4">
                            <div>
                                <p class="text-muted mb-1 small">Total Users</p>
                                <h3 class="fw-bold mb-0">{{ totalUsers|number_format }}</h3>
                            </div>
                            <div class="rounded-3 p-3" style="background-color: #e9d5ff;">
                                <i class="bi bi-people-fill" style="font-size: 1.8rem; color: #9333ea;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search & Filter -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <form method="get" class="row g-3">
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="text" name="search" class="form-control border-start-0"
                                       placeholder="Search ads by title, seller, or ID"
                                       value="{{ search }}"
                                       style="box-shadow: none;">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select name="category" class="form-select" onchange="this.form.submit()">
                                <option value="all">All Categories</option>
                                <option value="Electronics" {% if selectedCategory == 'Electronics' %}selected{% endif %}>Electronics</option>
                                <option value="Fashion" {% if selectedCategory == 'Fashion' %}selected{% endif %}>Fashion</option>
                                <option value="Automotive" {% if selectedCategory == 'Automotive' %}selected{% endif %}>Automotive</option>
                                <option value="Home & Garden" {% if selectedCategory == 'Home & Garden' %}selected{% endif %}>Home & Garden</option>
                                <option value="Sports" {% if selectedCategory == 'Sports' %}selected{% endif %}>Sports</option>
                                <option value="Books" {% if selectedCategory == 'Books' %}selected{% endif %}>Books</option>
                            </select>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Adverts Table -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead style="background-color: #f9fafb;">
                                <tr class="text-muted" style="font-size: 0.875rem;">
                                    <th class="border-0 fw-semibold p-3">Ad Details</th>
                                    <th class="border-0 fw-semibold">Seller</th>
                                    <th class="border-0 fw-semibold">Category</th>
                                    <th class="border-0 fw-semibold">Price</th>
                                    <th class="border-0 fw-semibold">Created</th>
                                    <th class="border-0 fw-semibold text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for advert in adverts %}
                                <tr style="border-bottom: 1px solid #f3f4f6;">
                                    <td class="p-3">
                                        <div class="d-flex align-items-center">
                                            {% if advert.image %}
                                            <img src="{{ advert.image|cloudinary_url }}"
                                                 alt="{{ advert.title }}"
                                                 class="advert-img me-3">
                                            {% else %}
                                            <div class="advert-img bg-light d-flex align-items-center justify-content-center me-3">
                                                <i class="bi bi-image text-muted"></i>
                                            </div>
                                            {% endif %}
                                            <div>
                                                <div class="fw-semibold">{{ advert.title }}</div>
                                                <small class="text-muted">ID: #AD-{{ advert.id }}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="Seller">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-2"
                                                 style="width: 35px; height: 35px; font-size: 0.75rem;">
                                                <strong>{{ advert.user.initials }}</strong>
                                            </div>
                                            <div>
                                                <div class="fw-semibold small">{{ advert.user.fullName }}</div>
                                                <small class="text-muted">{{ advert.user.username }}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="Category">
                                        {% if advert.category %}
                                        <span class="badge rounded-pill"
                                              style="background-color:
                                              {% if advert.category.name == 'Electronics' %}#dbeafe; color: #3b82f6;
                                              {% elseif advert.category.name == 'Fashion' %}#fce7f3; color: #ec4899;
                                              {% elseif advert.category.name == 'Automotive' %}#fed7aa; color: #f97316;
                                              {% else %}#e9d5ff; color: #9333ea;{% endif %}">
                                            {{ advert.category.name }}
                                        </span>
                                        {% else %}
                                        <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="fw-bold" data-label="Price">{{ advert.formattedPrice }}</td>
                                    <td class="text-muted small" data-label="Created">{{ advert.createdAt|date('M d, Y') }}</td>
                                    <td class="text-end" data-label="Actions">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <a href="{{ path('app_manager_advert_edit', {id: advert.id}) }}"
                                               class="btn btn-sm btn-link text-primary p-0"
                                               title="Edit">
                                                <i class="bi bi-pencil-square" style="font-size: 1.1rem;"></i>
                                            </a>
                                            <form method="post" action="{{ path('app_manager_advert_delete', {id: advert.id}) }}" style="display: inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ advert.id) }}">
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0"
                                                        onclick="return confirm('Are you sure you want to delete this advertisement?')"
                                                        title="Delete">
                                                    <i class="bi bi-trash" style="font-size: 1.1rem;"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                                        <p class="mt-2 mb-0">No advertisements found</p>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="p-3 border-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                Showing {{ ((currentPage - 1) * 10) + 1 }} to {{ min(currentPage * 10, adverts.totalItemCount) }} of {{ adverts.totalItemCount|number_format }} results
                            </small>

                            <div class="navigation">
                                {{ knp_pagination_render(adverts) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.querySelector('.sidebar-overlay');
        sidebar.classList.toggle('show');
        overlay.classList.toggle('show');
    }

    // Close sidebar when clicking nav links on mobile
    document.addEventListener('DOMContentLoaded', function() {
        const navLinks = document.querySelectorAll('.sidebar .nav-link');
        navLinks.forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth <= 991.98) {
                    toggleSidebar();
                }
            });
        });

        // Close sidebar on escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.querySelector('.sidebar-overlay');
                if (sidebar.classList.contains('show')) {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('show');
                }
            }
        });
    });
</script>
{% endblock %}

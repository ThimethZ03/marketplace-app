{% extends 'base.html.twig' %}

{% block title %}Edit Advertisement - Manager{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background-color: #f5f7fa;
        }
        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #fff;
            border-right: 1px solid #e5e7eb;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: transform 0.3s ease;
            overflow-y: auto;
        }
        .sidebar .nav-link {
            color: #6b7280;
            border-radius: 0.5rem;
            margin-bottom: 0.5rem;
            transition: all 0.2s;
        }
        .sidebar .nav-link:hover {
            background-color: #f3f4f6;
            color: #111827;
        }
        .sidebar .nav-link.active {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            color: white;
        }

        .main-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
        }

        .mobile-toggle {
            display: none;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .form-card {
            max-width: 800px;
        }

        /* ========================================
           MOBILE RESPONSIVE
           ======================================== */

        /* Tablet (992px and below) */
        @media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
                opacity: 1;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .mobile-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
                position: fixed;
                top: 1rem;
                left: 1rem;
                z-index: 1001;
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 0.5rem;
                padding: 0.5rem 0.75rem;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                cursor: pointer;
            }

            .mobile-toggle:hover {
                background: #f9fafb;
            }

            .mobile-toggle:active {
                transform: scale(0.95);
            }

            .header-user-info {
                display: none !important;
            }

            .form-card {
                max-width: 100%;
            }
        }

        /* Tablet/Phone (768px and below) */
        @media (max-width: 767.98px) {
            .main-content .p-4 {
                padding: 1.5rem !important;
            }

            h2 {
                font-size: 1.5rem;
            }

            .card-body.p-5 {
                padding: 2rem !important;
            }

            h3 {
                font-size: 1.5rem;
            }

            .form-label {
                font-size: 0.9rem;
            }

            .form-control,
            .form-select {
                font-size: 0.9rem;
            }

            .btn {
                font-size: 0.9rem;
            }
        }

        /* Phone (576px and below) */
        @media (max-width: 575.98px) {
            .mobile-toggle {
                top: 0.75rem;
                left: 0.75rem;
                padding: 0.4rem 0.6rem;
            }

            .mobile-toggle i {
                font-size: 1.3rem;
            }

            .main-content .p-4 {
                padding: 1rem !important;
                padding-top: 3.5rem !important;
            }

            .d-flex.justify-content-between.align-items-center.mb-4 {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 1rem;
            }

            h2 {
                font-size: 1.3rem;
                margin-bottom: 0.5rem !important;
            }

            .text-muted {
                font-size: 0.85rem;
            }

            .card-body.p-5 {
                padding: 1.5rem !important;
            }

            .text-center.mb-4 {
                margin-bottom: 1.5rem !important;
            }

            .text-center.mb-4 > div {
                width: 70px !important;
                height: 70px !important;
                margin-bottom: 1rem !important;
            }

            .text-center.mb-4 i {
                font-size: 1.8rem !important;
            }

            h3 {
                font-size: 1.3rem;
            }

            .text-center p {
                font-size: 0.9rem;
            }

            .mb-3 {
                margin-bottom: 1rem !important;
            }

            .form-label {
                font-size: 0.85rem;
                margin-bottom: 0.375rem !important;
            }

            .form-control,
            .form-select {
                font-size: 0.85rem;
                padding: 0.5rem 0.75rem;
            }

            textarea.form-control {
                font-size: 0.85rem !important;
            }

            .img-thumbnail {
                max-width: 150px !important;
                max-height: 150px !important;
            }

            small {
                font-size: 0.75rem !important;
            }

            .d-flex.gap-3 {
                flex-direction: column;
                gap: 0.75rem !important;
            }

            .btn {
                width: 100%;
                font-size: 0.85rem;
                padding: 0.625rem 1rem !important;
            }

            .btn i {
                font-size: 0.9rem;
            }

            /* Form errors */
            .invalid-feedback {
                font-size: 0.75rem;
            }

            /* Sidebar adjustments */
            .sidebar {
                width: 280px;
            }

            .sidebar .p-3 {
                padding: 1.25rem !important;
            }

            .sidebar .text-center {
                margin-bottom: 1.25rem !important;
            }

            .sidebar .text-center > div {
                width: 55px !important;
                height: 55px !important;
                margin-bottom: 0.75rem !important;
            }

            .sidebar .text-center i {
                font-size: 1.4rem !important;
            }

            .sidebar .text-center h5 {
                font-size: 1.1rem;
                margin-bottom: 0.25rem !important;
            }

            .sidebar .text-center small {
                font-size: 0.85rem;
            }

            .sidebar .nav-link {
                font-size: 0.9rem;
                padding: 0.625rem 0.75rem;
                margin-bottom: 0.375rem !important;
            }

            .sidebar .nav-link i {
                font-size: 0.95rem;
            }

            .sidebar .btn-outline-danger {
                font-size: 0.9rem;
                padding: 0.625rem 0.75rem;
            }

            .sidebar .btn-outline-danger i {
                font-size: 0.95rem;
            }
        }

        /* Very Small Phone (400px and below) */
        @media (max-width: 399.98px) {
            .mobile-toggle {
                top: 0.625rem;
                left: 0.625rem;
                padding: 0.375rem 0.55rem;
            }

            .mobile-toggle i {
                font-size: 1.2rem;
            }

            h2 {
                font-size: 1.2rem;
            }

            .card-body.p-5 {
                padding: 1.25rem !important;
            }

            .text-center.mb-4 > div {
                width: 60px !important;
                height: 60px !important;
            }

            .text-center.mb-4 i {
                font-size: 1.6rem !important;
            }

            h3 {
                font-size: 1.2rem;
            }

            .form-label {
                font-size: 0.8rem;
            }

            .form-control,
            .form-select {
                font-size: 0.8rem;
                padding: 0.45rem 0.65rem;
            }

            .btn {
                font-size: 0.8rem;
                padding: 0.5rem 0.875rem !important;
            }

            .img-thumbnail {
                max-width: 120px !important;
                max-height: 120px !important;
            }

            .sidebar {
                width: 260px;
            }

            .sidebar .p-3 {
                padding: 1rem !important;
            }

            .sidebar .text-center > div {
                width: 50px !important;
                height: 50px !important;
            }

            .sidebar .text-center i {
                font-size: 1.3rem !important;
            }

            .sidebar .text-center h5 {
                font-size: 1rem;
            }

            .sidebar .text-center small {
                font-size: 0.8rem;
            }

            .sidebar .nav-link {
                font-size: 0.85rem;
                padding: 0.5rem 0.625rem;
            }

            .sidebar .btn-outline-danger {
                font-size: 0.85rem;
                padding: 0.5rem 0.625rem;
            }
        }

        /* Landscape phones */
        @media (max-height: 500px) and (orientation: landscape) {
            .sidebar {
                max-height: 100vh;
            }

            .sidebar .text-center {
                margin-bottom: 1rem !important;
            }

            .sidebar .text-center > div {
                width: 45px !important;
                height: 45px !important;
                margin-bottom: 0.5rem !important;
            }

            .sidebar .text-center i {
                font-size: 1.2rem !important;
            }

            .sidebar .text-center h5 {
                font-size: 0.95rem;
            }

            .sidebar .text-center small {
                font-size: 0.75rem;
            }

            .sidebar .nav-link {
                padding: 0.5rem 0.625rem;
                margin-bottom: 0.25rem !important;
            }
        }
    </style>
{% endblock %}

{% block body %}
<!-- Mobile Menu Toggle -->
<button class="mobile-toggle btn" onclick="toggleSidebar()" aria-label="Toggle Menu">
    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
</button>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" onclick="toggleSidebar()"></div>

<div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar d-flex flex-column p-3" id="sidebar">
        <!-- Logo -->
        <div class="text-center mb-4">
            <div class="d-flex align-items-center justify-content-center rounded-3 mb-2 mx-auto"
                 style="width: 60px; height: 60px; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                <i class="bi bi-shield-check-fill text-white" style="font-size: 1.5rem;"></i>
            </div>
            <h5 class="fw-bold mb-0">Marketplace</h5>
            <small class="text-muted">Control Panel</small>
        </div>

        <!-- Navigation -->
        <nav class="flex-grow-1">
            <a href="{{ path('app_manager_dashboard') }}" class="nav-link active">
                <i class="bi bi-list-ul me-2"></i>All Adverts
            </a>
        </nav>

        <!-- Logout -->
        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger w-100">
            <i class="bi bi-box-arrow-right me-2"></i>Logout
        </a>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 main-content">
        <div class="p-4">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Advertisement Management</h2>
                    <p class="text-muted mb-0">Manage all advertisements</p>
                </div>
                <div class="d-flex align-items-center gap-3 header-user-info">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 45px; height: 45px;">
                        <strong>{{ app.user.initials }}</strong>
                    </div>
                    <div>
                        <div class="fw-semibold">{{ app.user.fullName }}</div>
                        <small class="text-muted">Manager</small>
                    </div>
                </div>
            </div>

            <!-- Edit Form Card -->
            <div class="card border-0 shadow-sm form-card">
                <div class="card-body p-5">
                    <!-- Icon and Title -->
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-3"
                             style="width: 80px; height: 80px; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                            <i class="bi bi-pencil-square text-white" style="font-size: 2rem;"></i>
                        </div>
                        <h3 class="fw-bold">Edit Add</h3>
                        <p class="text-muted">Update advertisement details</p>
                    </div>

                    <!-- Form -->
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <!-- Product Category -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Product category</label>
                        {{ form_widget(form.category, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.category) }}
                    </div>

                    <!-- Product Name -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Product name</label>
                        {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'iPhone .....'}}) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': '256GB .....'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <!-- Price -->
                    {% if form.price is defined %}
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Price</label>
                        {{ form_widget(form.price, {'attr': {'class': 'form-control', 'placeholder': '0.00'}}) }}
                        {{ form_errors(form.price) }}
                    </div>
                    {% endif %}

                    <!-- Phone Number -->
                    {% if form.phoneNumber is defined %}
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control', 'placeholder': '+94 77 4002074'}}) }}
                        {{ form_errors(form.phoneNumber) }}
                    </div>
                    {% endif %}

                    <!-- Current Image -->
                    {% if advert.image %}
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Current Image</label>
                        <div>
                            <img src="{{ advert.image|cloudinary_url }}"
                                 alt="{{ advert.title }}"
                                 class="img-thumbnail"
                                 style="max-width: 200px; max-height: 200px;">
                        </div>
                    </div>
                    {% endif %}

                    <!-- Add Image -->
                    {% if form.imagePath is defined %}
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Add Image</label>
                        {{ form_widget(form.imagePath, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.imagePath) }}
                        <small class="text-muted">Leave empty to keep current image</small>
                    </div>
                    {% endif %}

                    <!-- Buttons -->
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary px-5 py-2">
                            <i class="bi bi-check-circle me-2"></i>Save Changes
                        </button>
                        <a href="{{ path('app_manager_dashboard') }}" class="btn btn-danger px-5 py-2">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.querySelector('.sidebar-overlay');
        sidebar.classList.toggle('show');
        overlay.classList.toggle('show');
    }

    // Close sidebar when clicking nav links on mobile
    document.addEventListener('DOMContentLoaded', function() {
        const navLinks = document.querySelectorAll('.sidebar .nav-link');
        navLinks.forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth <= 991.98) {
                    toggleSidebar();
                }
            });
        });

        // Close sidebar on escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.querySelector('.sidebar-overlay');
                if (sidebar.classList.contains('show')) {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('show');
                }
            }
        });
    });
</script>
{% endblock %}

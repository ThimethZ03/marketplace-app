{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Marketplace{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .sidebar {
            width: 250px;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: transform 0.3s ease;
            overflow-y: auto;
        }

        .main-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
        }

        .mobile-toggle {
            display: none;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .stat-card {
            transition: transform 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-2px);
        }

        .sidebar-bottom {
            position: absolute;
            bottom: 0;
            width: 100%;
        }

        /* ========================================
           MOBILE RESPONSIVE
           ======================================== */

        /* Tablet (992px and below) */
        @media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
                opacity: 1;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .mobile-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
                position: fixed;
                top: 1rem;
                left: 1rem;
                z-index: 1001;
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 0.5rem;
                padding: 0.5rem 0.75rem;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                cursor: pointer;
            }

            .mobile-toggle:hover {
                background: #f9fafb;
            }

            .mobile-toggle:active {
                transform: scale(0.95);
            }

            .header-user-info {
                display: none !important;
            }

            .stat-card .card-body {
                padding: 1.25rem !important;
            }
        }

        /* Tablet/Phone (768px and below) */
        @media (max-width: 767.98px) {
            .bg-white.border-bottom.p-4 {
                padding: 1.5rem !important;
            }

            h4 {
                font-size: 1.5rem;
            }

            .stat-card h3 {
                font-size: 1.5rem;
            }

            .stat-card i {
                font-size: 1.6rem !important;
            }

            .stat-card .card-body {
                padding: 1rem !important;
            }

            .stat-card .rounded-3 {
                padding: 0.75rem !important;
            }

            .card-body.text-center.py-5 {
                padding: 2rem 1.5rem !important;
            }

            .card-body.text-center i {
                font-size: 2.5rem !important;
            }

            h5 {
                font-size: 1.25rem;
            }
        }

        /* Phone (576px and below) */
        @media (max-width: 575.98px) {
            .mobile-toggle {
                top: 0.75rem;
                left: 0.75rem;
                padding: 0.4rem 0.6rem;
            }

            .mobile-toggle i {
                font-size: 1.3rem;
            }

            .bg-light > .p-4 {
                padding: 1rem !important;
                padding-top: 4rem !important;
            }

            .bg-white.border-bottom.p-4 {
                padding: 1rem !important;
                padding-top: 3.5rem !important;
            }

            .d-flex.justify-content-between.align-items-center {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 0.75rem;
            }

            h4 {
                font-size: 1.3rem;
                margin-bottom: 0.5rem !important;
            }

            .text-muted {
                font-size: 0.85rem;
            }

            /* Stats cards */
            .row.g-4 {
                gap: 0.75rem !important;
            }

            .stat-card .card-body {
                padding: 0.875rem !important;
            }

            .stat-card .d-flex {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 0.75rem;
            }

            .stat-card h3 {
                font-size: 1.3rem;
            }

            .stat-card .text-muted {
                font-size: 0.8rem;
            }

            .stat-card i {
                font-size: 1.4rem !important;
            }

            .stat-card .rounded-3 {
                padding: 0.625rem !important;
            }

            /* Quick actions */
            .mt-2 {
                margin-top: 0.75rem !important;
            }

            .card-body.text-center.py-5 {
                padding: 1.5rem 1rem !important;
            }

            .card-body.text-center i {
                font-size: 2.25rem !important;
                margin-bottom: 0.75rem !important;
            }

            h5 {
                font-size: 1.15rem;
                margin-bottom: 0.5rem;
            }

            .card-body.text-center p {
                font-size: 0.85rem;
                margin-bottom: 1rem !important;
            }

            .btn {
                font-size: 0.875rem;
                padding: 0.5rem 1.25rem;
            }

            /* Sidebar adjustments */
            .sidebar {
                width: 280px;
            }

            .sidebar .p-4 {
                padding: 1.25rem !important;
            }

            .sidebar .d-flex.align-items-center {
                margin-bottom: 1rem !important;
            }

            .sidebar .bg-primary.rounded-3 {
                padding: 0.5rem !important;
            }

            .sidebar h5 {
                font-size: 1.1rem;
            }

            .sidebar .small {
                font-size: 0.85rem;
            }

            .sidebar .nav-link {
                font-size: 0.9rem;
                padding: 0.625rem 0.75rem;
            }

            .sidebar .nav-link i {
                font-size: 0.95rem;
            }

            .sidebar-bottom {
                position: relative;
                padding: 1.25rem !important;
                margin-top: 2rem;
            }

            .sidebar-bottom .btn {
                font-size: 0.9rem;
                padding: 0.625rem 0.75rem;
            }
        }

        /* Very Small Phone (400px and below) */
        @media (max-width: 399.98px) {
            .mobile-toggle {
                top: 0.625rem;
                left: 0.625rem;
                padding: 0.375rem 0.55rem;
            }

            .mobile-toggle i {
                font-size: 1.2rem;
            }

            h4 {
                font-size: 1.2rem;
            }

            .stat-card h3 {
                font-size: 1.2rem;
            }

            .stat-card i {
                font-size: 1.3rem !important;
            }

            .card-body.text-center i {
                font-size: 2rem !important;
            }

            h5 {
                font-size: 1.05rem;
            }

            .btn {
                font-size: 0.8rem;
                padding: 0.45rem 1rem;
            }

            .sidebar {
                width: 260px;
            }

            .sidebar .p-4 {
                padding: 1rem !important;
            }

            .sidebar h5 {
                font-size: 1rem;
            }

            .sidebar .nav-link {
                font-size: 0.85rem;
                padding: 0.5rem 0.625rem;
            }

            .sidebar-bottom {
                padding: 1rem !important;
            }

            .sidebar-bottom .btn {
                font-size: 0.85rem;
                padding: 0.5rem 0.625rem;
            }
        }

        /* Landscape phones */
        @media (max-height: 500px) and (orientation: landscape) {
            .sidebar {
                max-height: 100vh;
            }

            .sidebar .p-4 {
                padding: 1rem !important;
            }

            .sidebar .d-flex.align-items-center {
                margin-bottom: 0.75rem !important;
            }

            .sidebar .bg-primary.rounded-3 {
                padding: 0.4rem !important;
            }

            .sidebar h5 {
                font-size: 0.95rem;
            }

            .sidebar .small {
                font-size: 0.75rem;
            }

            .sidebar .nav-link {
                padding: 0.5rem 0.625rem;
            }

            .sidebar-bottom {
                position: relative;
                margin-top: 1rem;
                padding: 1rem !important;
            }
        }
    </style>
{% endblock %}

{% block body %}
<!-- Mobile Menu Toggle -->
<button class="mobile-toggle btn" onclick="toggleSidebar()" aria-label="Toggle Menu">
    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
</button>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" onclick="toggleSidebar()"></div>

<div class="d-flex">
    <!-- Sidebar -->
    <div class="bg-white border-end sidebar" id="sidebar">
        <div class="p-4">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary rounded-3 p-2 me-2">
                    <i class="bi bi-shield-check text-white"></i>
                </div>
                <h5 class="mb-0 fw-bold">Admin</h5>
            </div>
            <p class="small text-muted">Control Panel</p>

            <nav class="nav flex-column">
                <a class="nav-link text-dark" href="{{ path('app_admin_users') }}">
                    <i class="bi bi-people me-2"></i> Manage Users
                </a>
                <a class="nav-link text-dark" href="{{ path('app_admin_moderators') }}">
                    <i class="bi bi-person-badge me-2"></i> Moderator Actions
                </a>
            </nav>
        </div>

        <div class="sidebar-bottom p-4">
            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger w-100">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 bg-light main-content">
        <!-- Header -->
        <div class="bg-white border-bottom p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1">User Management</h4>
                    <p class="text-muted mb-0">Manage users and permissions</p>
                </div>
                <div class="d-flex align-items-center header-user-info">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                        <span class="text-primary fw-bold">{{ app.user.initials }}</span>
                    </div>
                    <div>
                        <div class="fw-bold">{{ app.user.fullName }}</div>
                        <small class="text-muted">Admin</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Dashboard -->
        <div class="p-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1">Total Ads</p>
                                    <h3 class="mb-0">{{ total_adverts|number_format }}</h3>
                                </div>
                                <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                                    <i class="bi bi-megaphone text-primary" style="font-size: 2rem;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1">Total Users</p>
                                    <h3 class="mb-0">{{ total_users|number_format }}</h3>
                                </div>
                                <div class="bg-secondary bg-opacity-10 rounded-3 p-3">
                                    <i class="bi bi-people text-secondary" style="font-size: 2rem;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1">Total Managers</p>
                                    <h3 class="mb-0">{{ total_managers }}</h3>
                                </div>
                                <div class="bg-success bg-opacity-10 rounded-3 p-3">
                                    <i class="bi bi-person-badge text-success" style="font-size: 2rem;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="row g-4 mt-2">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-people text-primary mb-3" style="font-size: 3rem;"></i>
                            <h5>Manage Users</h5>
                            <p class="text-muted">View and manage all registered users</p>
                            <a href="{{ path('app_admin_users') }}" class="btn btn-primary">Go to Users</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-person-badge text-success mb-3" style="font-size: 3rem;"></i>
                            <h5>Moderator Actions</h5>
                            <p class="text-muted">Promote or demote moderators</p>
                            <a href="{{ path('app_admin_moderators') }}" class="btn btn-success">Manage Moderators</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.querySelector('.sidebar-overlay');
        sidebar.classList.toggle('show');
        overlay.classList.toggle('show');
    }

    // Close sidebar when clicking nav links on mobile
    document.addEventListener('DOMContentLoaded', function() {
        const navLinks = document.querySelectorAll('.sidebar .nav-link');
        navLinks.forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth <= 991.98) {
                    toggleSidebar();
                }
            });
        });

        // Close sidebar on escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.querySelector('.sidebar-overlay');
                if (sidebar.classList.contains('show')) {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('show');
                }
            }
        });
    });
</script>
{% endblock %}

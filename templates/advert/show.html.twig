{% extends 'base.html.twig' %}

{% block title %}{{ advert.title }} - Marketplace{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary: #235aa3ff;
            --secondary: #1e508aff;
            --primary-color: #2356a3ff;
        }

        .text-primary { color: var(--primary) !important; }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, var(--secondary), #1a4577);
        }
        .btn-outline-primary {
            color: var(--primary);
            border-color: var(--primary);
        }
        .btn-outline-primary:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
        }

        .product-image {
            width: 100%;
            max-height: 500px;
            object-fit: cover;
        }

        .price-box {
            background: #f8f9fa;
            border-radius: 0.5rem;
            padding: 1.5rem;
        }

        .seller-card {
            background: #1a202c;
        }

        .thumbnail-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.5rem;
        }

        .thumbnail-item {
            background: #f8f9fa;
            border-radius: 0.375rem;
            height: 80px;
        }

        /* ========================================
           MOBILE RESPONSIVE
           ======================================== */

        /* Tablet (992px and below) */
        @media (max-width: 991.98px) {
            .product-image {
                max-height: 400px;
            }

            h1 {
                font-size: 1.75rem;
            }

            .price-box h2 {
                font-size: 1.75rem;
            }

            /* Navbar responsive */
            .navbar-brand {
                font-size: 1.3rem !important;
            }

            .navbar-collapse {
                margin-top: 15px;
            }

            .nav-item.ms-2 {
                margin-left: 0 !important;
                margin-top: 10px;
            }

            .btn-primary.btn-sm {
                width: 100%;
            }
        }

        /* Tablet/Phone (768px and below) */
        @media (max-width: 767.98px) {
            .container {
                padding-top: 2rem !important;
                padding-bottom: 2rem !important;
            }

            .product-image {
                max-height: 350px;
            }

            h1 {
                font-size: 1.5rem;
            }

            .price-box {
                padding: 1.25rem;
            }

            .price-box h2 {
                font-size: 1.5rem;
            }

            .btn-lg {
                padding: 0.75rem 1rem;
                font-size: 1rem;
            }

            .seller-card .card-body {
                padding: 1rem;
            }

            .seller-card .d-flex {
                flex-direction: column;
                gap: 0.75rem;
                align-items: flex-start !important;
            }

            .seller-card .d-flex .d-flex {
                flex-direction: row;
            }

            h4 {
                font-size: 1.25rem;
            }

            h5 {
                font-size: 1.1rem;
            }

            footer h5 {
                font-size: 1.1rem;
            }

            footer h6 {
                font-size: 1rem;
            }

            footer .small {
                font-size: 0.85rem !important;
            }
        }

        /* Phone (576px and below) */
        @media (max-width: 575.98px) {
            .container {
                padding-top: 1.5rem !important;
                padding-bottom: 1.5rem !important;
            }

            .col-lg-6.mb-4 {
                margin-bottom: 1.5rem !important;
            }

            .product-image {
                max-height: 280px;
                border-radius: 0.5rem !important;
            }

            .thumbnail-grid {
                grid-template-columns: repeat(4, 1fr);
                gap: 0.375rem;
                margin-top: 0.5rem !important;
            }

            .thumbnail-item {
                height: 60px;
            }

            h1 {
                font-size: 1.3rem;
                margin-bottom: 0.75rem !important;
            }

            .text-muted {
                font-size: 0.85rem;
            }

            .price-box {
                padding: 1rem;
                margin-bottom: 1rem !important;
            }

            .price-box h2 {
                font-size: 1.4rem;
            }

            .btn-lg {
                padding: 0.65rem 0.9rem;
                font-size: 0.9rem;
                margin-bottom: 0.75rem !important;
            }

            .btn-lg i {
                font-size: 0.9rem;
            }

            .seller-card .card-body {
                padding: 0.875rem;
                font-size: 0.85rem;
            }

            .seller-card .bi {
                font-size: 1.1rem;
            }

            h4 {
                font-size: 1.15rem;
                padding-bottom: 0.5rem !important;
            }

            h5 {
                font-size: 1rem;
            }

            .list-unstyled li {
                font-size: 0.9rem;
                margin-bottom: 0.375rem;
            }

            .list-unstyled i {
                font-size: 0.85rem;
            }

            /* Related products */
            .mt-5 {
                margin-top: 2rem !important;
            }

            .mt-5 h3 {
                font-size: 1.25rem;
                margin-bottom: 1rem !important;
            }

            .card-img-top,
            .card-img-top.bg-light {
                height: 120px !important;
            }

            .card-img-top i {
                font-size: 1.5rem !important;
            }

            .card-body {
                padding: 0.875rem;
            }

            .card-title {
                font-size: 0.9rem;
            }

            .card-body .fw-bold {
                font-size: 1rem;
            }

            .card-footer {
                padding: 0.75rem;
            }

            .btn-sm {
                font-size: 0.8rem;
                padding: 0.4rem 0.75rem;
            }

            /* Footer */
            footer {
                padding: 1.5rem 0 !important;
                margin-top: 2rem !important;
            }

            footer h5 {
                font-size: 1rem;
                margin-bottom: 0.75rem;
            }

            footer h6 {
                font-size: 0.95rem;
                margin-bottom: 0.75rem;
            }

            footer .small {
                font-size: 0.8rem !important;
            }

            footer .bi-facebook,
            footer .bi-twitter,
            footer .bi-instagram {
                font-size: 1.3rem;
            }

            footer ul li {
                margin-bottom: 0.375rem;
            }
        }

        /* Very Small Phone (400px and below) */
        @media (max-width: 399.98px) {
            h1 {
                font-size: 1.2rem;
            }

            .product-image {
                max-height: 250px;
            }

            .thumbnail-item {
                height: 50px;
            }

            .price-box h2 {
                font-size: 1.3rem;
            }

            .btn-lg {
                font-size: 0.85rem;
                padding: 0.6rem 0.8rem;
            }

            .seller-card .card-body {
                font-size: 0.8rem;
            }

            h4 {
                font-size: 1.05rem;
            }

            h5 {
                font-size: 0.95rem;
            }

            .list-unstyled li {
                font-size: 0.85rem;
            }

            .card-img-top,
            .card-img-top.bg-light {
                height: 110px !important;
            }

            .card-title {
                font-size: 0.85rem;
            }

            .card-body .fw-bold {
                font-size: 0.95rem;
            }
        }
    </style>
{% endblock %}

{% block navbar %}
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="{{ path('app_home') }}" style="color: var(--primary-color); font-size: 1.5rem;">
            <i class="bi bi-shop"></i>
            Marketplace
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item">
                    <a class="nav-link fw-semibold" href="{{ path('app_home') }}">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-semibold" href="{{ path('app_advert_list') }}">Categories</a>
                </li>
                <li class="nav-item ms-2">
                    <a class="btn btn-primary btn-sm text-white" href="{{ path('app_login') }}" style="border-radius: 50px; padding: 8px 24px;">Sign In</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <!-- Product Images -->
        <div class="col-lg-6 mb-4">
            {% if advert.image %}
                <img src="{{ advert.image|cloudinary_url }}" class="product-image img-fluid rounded shadow" alt="{{ advert.title }}">
            {% else %}
                <div class="bg-light rounded shadow d-flex align-items-center justify-content-center" style="width: 100%; height: 500px;">
                    <i class="bi bi-image text-muted" style="font-size: 5rem;"></i>
                </div>
            {% endif %}

            <!-- Additional Images Placeholder -->
            <div class="thumbnail-grid mt-2">
                <div class="thumbnail-item"></div>
                <div class="thumbnail-item"></div>
                <div class="thumbnail-item"></div>
                <div class="thumbnail-item"></div>
            </div>
        </div>

        <!-- Product Details -->
        <div class="col-lg-6">
            <h1 class="fw-bold mb-3">{{ advert.title }}</h1>
            <p class="text-muted">Posted on {{ advert.formattedDate }}{% if advert.location %}, {{ advert.location }}{% endif %}</p>

            <div class="price-box mb-4">
                <h2 class="text-primary mb-0">{{ advert.formattedPrice }}</h2>
            </div>

            <div class="mb-4">
                <a href="tel:{{ advert.phoneNumber ?? app.user.phoneNumber }}" class="btn btn-primary btn-lg w-100 mb-2 text-white">
                    <i class="bi bi-telephone me-2"></i> Contact +{{ advert.phoneNumber ?? app.user.phoneNumber }}
                </a>

                <div class="card border-0 seller-card text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Seller - {{ advert.user.fullName }} - Chat Now</span>
                            <div class="d-flex gap-2">
                                {% if advert.user.facebookLink %}
                                    <a href="{{ advert.user.facebookLink }}" target="_blank" class="text-white"><i class="bi bi-facebook"></i></a>
                                {% endif %}
                                {% if advert.user.twitterLink %}
                                    <a href="{{ advert.user.twitterLink }}" target="_blank" class="text-white"><i class="bi bi-twitter"></i></a>
                                {% endif %}
                                {% if advert.user.instagramLink %}
                                    <a href="{{ advert.user.instagramLink }}" target="_blank" class="text-white"><i class="bi bi-instagram"></i></a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Description -->
            <div class="mb-4">
                <h4 class="border-bottom pb-2 text-primary">Product Description</h4>
                <p>{{ advert.description }}</p>
            </div>

            <!-- Key Features -->
            <div class="mb-4">
                <h5 class="text-primary">Key Features</h5>
                <ul class="list-unstyled">
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Category: {{ advert.category ? advert.category.name : 'N/A' }}</li>
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Location: {{ advert.location ?? 'Not specified' }}</li>
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Posted: {{ advert.formattedDate }}</li>
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> ID: {{ advert.advertId }}</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- You might also like -->
    {% if related_adverts|length > 0 %}
    <div class="mt-5">
        <h3 class="mb-4">You might also like</h3>
        <div class="row g-4">
            {% for related in related_adverts %}
            <div class="col-6 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    {% if related.image %}
                        <img src="{{ related.image|cloudinary_url }}" class="card-img-top" alt="{{ related.title }}" style="height: 150px; object-fit: cover;">
                    {% else %}
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
                            <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                        </div>
                    {% endif %}
                    <div class="card-body">
                        <h6 class="card-title">{{ related.title }}</h6>
                        <p class="fw-bold text-primary mb-0">{{ related.formattedPrice }}</p>
                    </div>
                    <div class="card-footer bg-transparent border-0">
                        <a href="{{ path('app_advert_show', {id: related.id}) }}" class="btn btn-sm btn-outline-primary w-100">View</a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block footer %}
<footer class="bg-dark text-white py-4 mt-5" style="background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%) !important;">
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-3">
                <h5><i class="bi bi-shop"></i> Marketplace</h5>
                <p class="small" style="opacity: 0.8;">Your trusted platform to buy, sell, and discover the best deals online.</p>
            </div>
            <div class="col-md-4 mb-3">
                <h6>Products</h6>
                <ul class="list-unstyled small">
                    <li><a href="#" class="text-white-50 text-decoration-none">Smartphones</a></li>
                    <li><a href="#" class="text-white-50 text-decoration-none">Laptops</a></li>
                    <li><a href="#" class="text-white-50 text-decoration-none">Accessories</a></li>
                </ul>
            </div>
            <div class="col-md-4 mb-3">
                <h6>Connect</h6>
                <div class="d-flex gap-3">
                    <a href="#" class="text-white" style="opacity: 0.8;"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-white" style="opacity: 0.8;"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="text-white" style="opacity: 0.8;"><i class="bi bi-instagram"></i></a>
                </div>
            </div>
        </div>
        <hr class="border-secondary" style="opacity: 0.2;">
        <p class="text-center small mb-0" style="opacity: 0.7;">© 2025 Marketplace. All rights reserved.</p>
    </div>
</footer>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Sign In - Marketplace{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #235aa3ff 0%, #1e508aff 100%);
            --primary-color: #2356a3ff;
        }

        body {
            overflow-x: hidden;
        }

        /* Left Side - Gradient Section */
        .gradient-side {
            background: var(--primary-gradient);
            position: relative;
            overflow: hidden;
        }

        .gradient-side::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: rotate 30s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .welcome-content {
            position: relative;
            z-index: 1;
        }

        .feature-box {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            padding: 16px;
            width: 85px;
            height: 85px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .feature-box:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-5px);
        }

        .feature-box i {
            font-size: 1.9rem;
        }

        /* Right Side - Form Section */
        .form-side {
            background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
        }

        .login-card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        }

        .logo-box {
            width: 55px;
            height: 55px;
            background: var(--primary-gradient);
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            box-shadow: 0 6px 16px rgba(35, 90, 163, 0.3);
        }

        .form-label {
            font-weight: 600;
            color: #1a202c;
            margin-bottom: 6px;
            font-size: 0.85rem;
        }

        .input-group {
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            overflow: hidden;
            transition: all 0.3s ease;
            background: white;
        }

        .input-group:focus-within {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(35, 90, 163, 0.1);
        }

        .input-group-text {
            background: transparent;
            border: none;
            padding-left: 12px;
        }

        .form-control {
            border: none;
            padding: 11px 12px;
            font-size: 0.9rem;
            background: transparent;
        }

        .form-control:focus {
            box-shadow: none;
            background: transparent;
        }

        .toggle-password-btn {
            background: transparent;
            border: none;
            padding-right: 12px;
            cursor: pointer;
        }

        .btn-primary-gradient {
            background: var(--primary-gradient);
            border: none;
            padding: 11px 20px;
            font-weight: 600;
            font-size: 0.9rem;
            border-radius: 10px;
            transition: all 0.3s ease;
            color: white;
        }

        .btn-primary-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(35, 90, 163, 0.4);
        }

        .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

        .alert {
            border: none;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 0.9rem;
        }

        /* Footer */
        .login-footer {
            background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
            color: #cbd5e0;
            padding: 20px 0;
        }

        /* ========================================
           MOBILE RESPONSIVE
           ======================================== */

        /* Tablet (992px and below) */
        @media (max-width: 991.98px) {
            .gradient-side {
                min-height: 300px;
                padding: 30px 20px !important;
            }

            .welcome-content h1 {
                font-size: 1.8rem !important;
            }

            .welcome-content p {
                font-size: 0.9rem !important;
            }

            .feature-box {
                width: 75px;
                height: 75px;
                padding: 14px;
            }

            .feature-box i {
                font-size: 1.6rem;
            }

            .feature-box + p {
                font-size: 0.8rem !important;
            }

            .login-card {
                margin: 25px 0;
                padding: 25px;
            }

            .logo-box {
                width: 50px;
                height: 50px;
                margin-bottom: 12px;
            }

            .logo-box i {
                font-size: 1.4rem !important;
            }

            .login-card h2 {
                font-size: 1.3rem !important;
            }

            .login-footer {
                padding: 18px 0;
            }
        }

        /* Phone (768px and below) */
        @media (max-width: 767.98px) {
            .gradient-side {
                min-height: 250px;
                padding: 25px 15px !important;
            }

            .welcome-content h1 {
                font-size: 1.6rem !important;
            }

            .welcome-content p {
                font-size: 0.85rem !important;
            }

            .feature-box {
                width: 70px;
                height: 70px;
                padding: 12px;
            }

            .feature-box i {
                font-size: 1.4rem;
            }

            .feature-box + p {
                font-size: 0.75rem !important;
                margin-top: 8px !important;
            }

            .welcome-content .btn {
                font-size: 0.85rem !important;
                padding: 9px 20px !important;
            }

            .login-card {
                padding: 22px;
                border-radius: 14px;
            }

            .logo-box {
                width: 48px;
                height: 48px;
            }

            .logo-box i {
                font-size: 1.3rem !important;
            }

            .login-card h2 {
                font-size: 1.2rem !important;
            }

            .login-card p {
                font-size: 0.8rem !important;
            }

            .form-label {
                font-size: 0.8rem;
                margin-bottom: 5px;
            }

            .form-control {
                padding: 10px 11px;
                font-size: 0.85rem;
            }

            .input-group-text,
            .toggle-password-btn {
                padding-left: 10px;
                padding-right: 10px;
            }

            .input-group-text i,
            .toggle-password-btn i {
                font-size: 0.85rem !important;
            }

            .btn-primary-gradient {
                padding: 10px 18px;
                font-size: 0.85rem;
            }

            .form-check-label {
                font-size: 0.8rem !important;
            }

            .btn-outline-secondary {
                padding: 7px 14px !important;
                font-size: 0.85rem !important;
            }

            .login-footer {
                padding: 16px 0;
            }

            .login-footer .small {
                font-size: 0.75rem !important;
            }
        }

        /* Small Phone (576px and below) */
        @media (max-width: 575.98px) {
            .gradient-side {
                min-height: 220px;
                padding: 20px 12px !important;
            }

            .welcome-content h1 {
                font-size: 1.4rem !important;
                margin-bottom: 12px !important;
            }

            .welcome-content > div:first-child {
                margin-bottom: 1.5rem !important;
            }

            .welcome-content p {
                font-size: 0.8rem !important;
            }

            .feature-box {
                width: 65px;
                height: 65px;
                padding: 10px;
                border-radius: 10px;
            }

            .feature-box i {
                font-size: 1.3rem;
            }

            .feature-box + p {
                font-size: 0.7rem !important;
                margin-top: 6px !important;
            }

            .welcome-content .mt-4 {
                margin-top: 1.2rem !important;
            }

            .welcome-content .pt-3 {
                padding-top: 0.8rem !important;
            }

            .welcome-content .btn {
                font-size: 0.8rem !important;
                padding: 8px 18px !important;
            }

            .login-card {
                padding: 20px;
                border-radius: 12px;
            }

            .logo-box {
                width: 45px;
                height: 45px;
                margin-bottom: 10px;
            }

            .logo-box i {
                font-size: 1.2rem !important;
            }

            .login-card h2 {
                font-size: 1.15rem !important;
            }

            .form-label {
                font-size: 0.78rem;
            }

            .form-control {
                padding: 9px 10px;
                font-size: 0.82rem;
            }

            .form-control::placeholder {
                font-size: 0.8rem;
            }

            .btn-primary-gradient {
                padding: 9px 16px;
                font-size: 0.82rem;
            }

            .btn-primary-gradient i {
                font-size: 0.8rem;
            }

            .alert {
                padding: 10px 12px;
                font-size: 0.82rem;
            }

            .d-flex.gap-2 {
                gap: 0.4rem !important;
            }

            .btn-outline-secondary {
                padding: 6px 12px !important;
                font-size: 0.8rem !important;
            }

            .login-footer {
                padding: 14px 0;
            }

            .login-footer .small {
                font-size: 0.72rem !important;
            }

            .login-footer .me-3 {
                margin-right: 0.8rem !important;
            }
        }

        /* Very Small Phone (400px and below) */
        @media (max-width: 399.98px) {
            .gradient-side {
                min-height: 200px;
                padding: 18px 10px !important;
            }

            .welcome-content h1 {
                font-size: 1.3rem !important;
            }

            .feature-box {
                width: 60px;
                height: 60px;
            }

            .feature-box i {
                font-size: 1.2rem;
            }

            .login-card {
                padding: 18px;
            }

            .logo-box {
                width: 42px;
                height: 42px;
            }

            .logo-box i {
                font-size: 1.1rem !important;
            }

            .login-card h2 {
                font-size: 1.1rem !important;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid p-0">
    <div class="row g-0 min-vh-100">
        <!-- Left Side - Welcome Section -->
        <div class="col-lg-6 gradient-side d-flex align-items-center justify-content-center p-4">
            <div class="welcome-content text-center text-white">
                <div class="mb-4">
                    <h1 class="fw-bold mb-3" style="font-size: 2.2rem;">Welcome Back!</h1>
                    <p class="mb-0" style="opacity: 0.95; font-size: 1rem;">Sign in to access your dashboard and manage your advertisements</p>
                </div>

                <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                    <div class="text-center">
                        <div class="feature-box">
                            <i class="bi bi-shop"></i>
                        </div>
                        <p class="mt-2 mb-0 fw-semibold" style="font-size: 0.85rem;">Browse<br>Products</p>
                    </div>
                    <div class="text-center">
                        <div class="feature-box">
                            <i class="bi bi-speedometer2"></i>
                        </div>
                        <p class="mt-2 mb-0 fw-semibold" style="font-size: 0.85rem;">Manage<br>Dashboard</p>
                    </div>
                    <div class="text-center">
                        <div class="feature-box">
                            <i class="bi bi-megaphone"></i>
                        </div>
                        <p class="mt-2 mb-0 fw-semibold" style="font-size: 0.85rem;">Post<br>Ads</p>
                    </div>
                </div>

                <div class="mt-4 pt-3">
                    <p class="mb-2" style="opacity: 0.9; font-size: 0.9rem;">Don't have an account?</p>
                    <a href="{{ path('app_register') }}" class="btn btn-light px-4" style="border-radius: 50px; font-weight: 600; padding: 10px 24px; font-size: 0.9rem;">
                        Create Account
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Side - Login Form -->
        <div class="col-lg-6 form-side d-flex align-items-center justify-content-center p-3">
            <div class="w-100" style="max-width: 440px;">
                <div class="login-card">
                    <div class="text-center mb-3">
                        <div class="logo-box">
                            <i class="bi bi-lock-fill text-white" style="font-size: 1.6rem;"></i>
                        </div>
                        <h2 class="fw-bold mb-1" style="color: #1a202c; font-size: 1.5rem;">Sign In</h2>
                        <p class="text-muted mb-0" style="font-size: 0.85rem;">Enter your credentials to continue</p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger d-flex align-items-center mb-3">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login') }}">
                        <div class="mb-3">
                            <label for="inputEmail" class="form-label">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope text-muted" style="font-size: 0.9rem;"></i>
                                </span>
                                <input
                                    type="email"
                                    value="{{ last_username }}"
                                    name="_username"
                                    id="inputEmail"
                                    class="form-control"
                                    placeholder="your.email@example.com"
                                    required
                                    autofocus
                                    autocomplete="email">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="inputPassword" class="form-label">Password</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock text-muted" style="font-size: 0.9rem;"></i>
                                </span>
                                <input
                                    type="password"
                                    name="_password"
                                    id="inputPassword"
                                    class="form-control"
                                    placeholder="Enter your password"
                                    required
                                    autocomplete="current-password">
                                <button class="toggle-password-btn" type="button" onclick="togglePassword()">
                                    <i class="bi bi-eye text-muted" id="toggleIcon" style="font-size: 0.9rem;"></i>
                                </button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="_remember_me" id="remember_me">
                                <label class="form-check-label" for="remember_me" style="color: #4b5563; font-size: 0.85rem;">
                                    Remember me
                                </label>
                            </div>
                            <a href="#" class="text-decoration-none fw-semibold" style="color: var(--primary-color); font-size: 0.8rem;">
                                Forgot password?
                            </a>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button class="btn btn-primary-gradient w-100 mb-3" type="submit">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In to Account
                        </button>

                        <div class="text-center">
                            <p class="text-muted mb-2" style="font-size: 0.8rem;">Or continue with</p>
                            <div class="d-flex gap-2 justify-content-center">
                                <button type="button" class="btn btn-outline-secondary" style="border-radius: 10px; padding: 8px 16px; font-size: 0.9rem;">
                                    <i class="bi bi-google"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" style="border-radius: 10px; padding: 8px 16px; font-size: 0.9rem;">
                                    <i class="bi bi-facebook"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" style="border-radius: 10px; padding: 8px 16px; font-size: 0.9rem;">
                                    <i class="bi bi-twitter"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <p class="text-center text-muted mt-3" style="font-size: 0.85rem;">
                    New to Marketplace?
                    <a href="{{ path('app_register') }}" class="text-decoration-none fw-bold" style="color: var(--primary-color);">
                        Create an account
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

<script>
function togglePassword() {
    const input = document.getElementById('inputPassword');
    const icon = document.getElementById('toggleIcon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('bi-eye');
        icon.classList.add('bi-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.remove('bi-eye-slash');
        icon.classList.add('bi-eye');
    }
}
</script>
{% endblock %}

{% block footer %}
<footer class="login-footer">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                <p class="mb-0 small" style="opacity: 0.8;">© 2025 Marketplace. All rights reserved.</p>
            </div>
            <div class="col-md-6 text-center text-md-end">
                <a href="#" class="text-decoration-none me-3 small" style="color: #cbd5e0; opacity: 0.8;">Privacy Policy</a>
                <a href="#" class="text-decoration-none me-3 small" style="color: #cbd5e0; opacity: 0.8;">Terms of Service</a>
                <a href="#" class="text-decoration-none small" style="color: #cbd5e0; opacity: 0.8;">Help Center</a>
            </div>
        </div>
    </div>
</footer>
{% endblock %}

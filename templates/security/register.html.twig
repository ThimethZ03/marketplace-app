{% extends 'base.html.twig' %}

{% block title %}Create Account - Marketplace{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #235aa3ff 0%, #1e508aff 100%);
            --primary-color: #2356a3ff;
        }

        body {
            overflow: hidden;
        }

        .form-side {
            background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
            height: 100vh;
            overflow-y: auto;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 20px 8px;
        }

        .form-side::-webkit-scrollbar {
            width: 6px;
        }

        .form-side::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .form-side::-webkit-scrollbar-thumb {
            background: var(--primary-color);
            border-radius: 3px;
        }

        .register-card {
            background: white;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 6px 24px rgba(0,0,0,0.06);
            width: 100%;
        }

        /* Icon next to heading layout */
        .header-with-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 8px;
        }

        .logo-icon {
            width: 42px;
            height: 42px;
            background: var(--primary-gradient);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(35, 90, 163, 0.25);
        }

        .form-label {
            font-weight: 600;
            color: #1a202c;
            margin-bottom: 5px;
            font-size: 0.78rem;
        }

        .input-group {
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            overflow: hidden;
            transition: all 0.3s ease;
            background: white;
        }

        .input-group:focus-within {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(35, 90, 163, 0.08);
        }

        .input-group-text {
            background: transparent;
            border: none;
            padding: 0 10px;
        }

        .input-group-text i {
            font-size: 0.82rem;
        }

        .form-control {
            border: none;
            padding: 8px 10px;
            font-size: 0.82rem;
            background: transparent;
            height: 36px;
        }

        .form-control:focus {
            box-shadow: none;
            background: transparent;
        }

        .form-control::placeholder {
            font-size: 0.78rem;
        }

        .mb-compact {
            margin-bottom: 10px !important;
        }

        .btn-primary-gradient {
            background: var(--primary-gradient);
            border: none;
            padding: 9px 16px;
            font-weight: 600;
            font-size: 0.85rem;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            height: 38px;
        }

        .btn-primary-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(35, 90, 163, 0.35);
        }

        .gradient-side {
            background: var(--primary-gradient);
            position: relative;
            overflow: hidden;
            height: 100vh;
        }

        .gradient-side::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: rotate 30s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .info-content {
            position: relative;
            z-index: 1;
        }

        .illustration-compact {
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .feature-compact {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(5px);
            border-radius: 8px;
            padding: 9px 12px;
            margin-bottom: 7px;
            transition: all 0.3s ease;
            font-size: 0.85rem;
        }

        .feature-compact:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateX(5px);
        }

        .feature-compact i {
            font-size: 1rem;
        }

        .collapse-toggle {
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .collapse-toggle:hover {
            color: var(--primary-color) !important;
        }

        .toggle-password-btn {
            background: transparent;
            border: none;
            padding: 0 10px;
            cursor: pointer;
        }

        .toggle-password-btn i {
            font-size: 0.82rem;
        }

        .invalid-feedback {
            font-size: 0.72rem;
        }

        .form-wrapper {
            width: 100%;
            max-width: 460px;
            margin: auto 0;
        }

        /* ========================================
           RESPONSIVE FOR MOBILE & TABLET
           ======================================== */

        /* Tablet (Bootstrap md: 768px and below) */
        @media (max-width: 767.98px) {
            .form-side {
                padding: 15px 12px;
            }

            .register-card {
                padding: 18px;
                border-radius: 12px;
            }

            .form-wrapper {
                max-width: 100%;
            }

            .header-with-icon {
                gap: 10px;
                margin-bottom: 6px;
            }

            .logo-icon {
                width: 38px;
                height: 38px;
            }

            .logo-icon i {
                font-size: 1.2rem !important;
            }

            .header-with-icon h3 {
                font-size: 1.25rem !important;
            }

            .form-label {
                font-size: 0.75rem;
                margin-bottom: 4px;
            }

            .form-control {
                height: 38px;
                padding: 9px 10px;
                font-size: 0.85rem;
            }

            .input-group-text {
                padding: 0 9px;
            }

            .mb-compact {
                margin-bottom: 12px !important;
            }
        }

        /* Phone (Bootstrap sm: 576px and below) */
        @media (max-width: 575.98px) {
            .form-side {
                padding: 12px 10px;
            }

            .register-card {
                padding: 16px;
                border-radius: 10px;
                box-shadow: 0 4px 16px rgba(0,0,0,0.06);
            }

            .header-with-icon {
                flex-direction: column;
                gap: 8px;
                margin-bottom: 8px;
            }

            .logo-icon {
                width: 40px;
                height: 40px;
            }

            .logo-icon i {
                font-size: 1.25rem !important;
            }

            .header-with-icon h3 {
                font-size: 1.3rem !important;
            }

            .header-with-icon + p {
                font-size: 0.75rem !important;
                margin-bottom: 1rem !important;
            }

            .form-label {
                font-size: 0.75rem;
                margin-bottom: 4px;
            }

            .form-control {
                height: 40px;
                padding: 10px;
                font-size: 0.88rem;
            }

            .form-control::placeholder {
                font-size: 0.82rem;
            }

            .input-group-text {
                padding: 0 10px;
            }

            .input-group-text i {
                font-size: 0.85rem;
            }

            .toggle-password-btn i {
                font-size: 0.85rem;
            }

            .btn-primary-gradient {
                height: 42px;
                padding: 10px 16px;
                font-size: 0.88rem;
            }

            .mb-compact {
                margin-bottom: 14px !important;
            }

            .collapse-toggle {
                font-size: 0.78rem !important;
            }

            /* Larger touch targets on mobile */
            .collapse-toggle {
                padding: 4px 8px !important;
            }
        }

        /* Very small phones (below 400px) */
        @media (max-width: 399.98px) {
            .form-side {
                padding: 10px 8px;
            }

            .register-card {
                padding: 14px;
            }

            .header-with-icon h3 {
                font-size: 1.2rem !important;
            }

            .form-label {
                font-size: 0.72rem;
            }

            .form-control {
                font-size: 0.85rem;
                padding: 9px;
            }

            /* Stack phone/city on very small screens */
            .row.g-2 > .col-6 {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid p-0">
    <div class="row g-0">
        <!-- Left Side - Compact Form -->
        <div class="col-lg-6 form-side">
            <div class="form-wrapper">
                <div class="register-card">
                    <div class="text-center">
                        <div class="header-with-icon">
                            <div class="logo-icon">
                                <i class="bi bi-rocket-takeoff-fill text-white" style="font-size: 1.3rem;"></i>
                            </div>
                            <h3 class="fw-bold mb-0" style="color: #1a202c; font-size: 1.35rem;">Create Account</h3>
                        </div>
                        <p class="text-muted mb-3" style="font-size: 0.78rem;">Join our marketplace community</p>
                    </div>

                    {{ form_start(registrationForm) }}

                    <!-- First Name & Last Name -->
                    <div class="row g-2 mb-compact">
                        <div class="col-6">
                            <label class="form-label">First Name</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person text-muted"></i>
                                </span>
                                {{ form_widget(registrationForm.firstName, {
                                    'attr': {'class': 'form-control', 'placeholder': 'John'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.firstName) }}
                        </div>
                        <div class="col-6">
                            <label class="form-label">Last Name</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person text-muted"></i>
                                </span>
                                {{ form_widget(registrationForm.lastName, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Doe'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.lastName) }}
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="mb-compact">
                        <label class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-envelope text-muted"></i>
                            </span>
                            {{ form_widget(registrationForm.email, {
                                'attr': {'class': 'form-control', 'placeholder': 'john@example.com'}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <!-- Phone & Address in Row -->
                    <div class="row g-2 mb-compact">
                        <div class="col-6">
                            <label class="form-label">Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-telephone text-muted"></i>
                                </span>
                                {{ form_widget(registrationForm.phoneNumber, {
                                    'attr': {'class': 'form-control', 'placeholder': '+94 771234567'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.phoneNumber) }}
                        </div>
                        <div class="col-6">
                            <label class="form-label">City</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-geo-alt text-muted"></i>
                                </span>
                                {{ form_widget(registrationForm.address, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Colombo'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.address) }}
                        </div>
                    </div>

                    <!-- Social Media (Collapsible) -->
                    <div class="mb-compact">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0">Social Links <small class="text-muted" style="font-size: 0.7rem;">(Optional)</small></label>
                            <button class="btn btn-sm btn-link text-decoration-none p-0 collapse-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#socialMedia" style="color: var(--primary-color); font-size: 0.75rem;">
                                <i class="bi bi-chevron-down"></i> Show
                            </button>
                        </div>

                        <div class="collapse" id="socialMedia">
                            <div class="input-group mb-2">
                                <span class="input-group-text"><i class="bi bi-facebook text-muted"></i></span>
                                {{ form_widget(registrationForm.facebookLink, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Facebook URL'}
                                }) }}
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text"><i class="bi bi-instagram text-muted"></i></span>
                                {{ form_widget(registrationForm.instagramLink, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Instagram URL'}
                                }) }}
                            </div>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-twitter text-muted"></i></span>
                                {{ form_widget(registrationForm.twitterLink, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Twitter URL'}
                                }) }}
                            </div>
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="mb-compact">
                        <label class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock text-muted"></i>
                            </span>
                            {{ form_widget(registrationForm.password.first, {
                                'attr': {'class': 'form-control', 'placeholder': '••••••••', 'id': 'password_first'}
                            }) }}
                            <button class="toggle-password-btn" type="button" onclick="togglePassword('password_first', 'icon1')">
                                <i class="bi bi-eye text-muted" id="icon1"></i>
                            </button>
                        </div>
                        {{ form_errors(registrationForm.password.first) }}
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-2">
                        <label class="form-label">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock-fill text-muted"></i>
                            </span>
                            {{ form_widget(registrationForm.password.second, {
                                'attr': {'class': 'form-control', 'placeholder': '••••••••', 'id': 'password_second'}
                            }) }}
                            <button class="toggle-password-btn" type="button" onclick="togglePassword('password_second', 'icon2')">
                                <i class="bi bi-eye text-muted" id="icon2"></i>
                            </button>
                        </div>
                        {{ form_errors(registrationForm.password.second) }}
                    </div>

                    <button type="submit" class="btn btn-primary-gradient w-100 mb-2">
                        <i class="bi bi-rocket-takeoff me-1" style="font-size: 0.8rem;"></i>Create Account
                    </button>

                    <p class="text-center text-muted mb-0" style="font-size: 0.78rem;">
                        Already registered?
                        <a href="{{ path('app_login') }}" class="text-decoration-none fw-bold" style="color: var(--primary-color);">Sign in</a>
                    </p>

                    {{ form_end(registrationForm) }}
                </div>
            </div>
        </div>

        <!-- Right Side - Compact Info (Hidden on mobile) -->
        <div class="col-lg-6 gradient-side d-none d-lg-flex align-items-center justify-content-center p-3">
            <div class="info-content text-center text-white" style="max-width: 400px;">
                <div class="illustration-compact">
                    <svg width="140" height="140" viewBox="0 0 180 180" fill="none">
                        <rect x="50" y="70" width="80" height="90" rx="8" fill="white" opacity="0.9"/>
                        <path d="M 65,70 L 65,55 Q 65,40 90,40 Q 115,40 115,55 L 115,70" stroke="white" stroke-width="3" fill="none" opacity="0.9"/>
                        <circle cx="30" cy="30" r="3" fill="white" opacity="0.7"/>
                        <circle cx="150" cy="40" r="3" fill="white" opacity="0.7"/>
                        <circle cx="160" cy="140" r="3" fill="white" opacity="0.7"/>
                        <circle cx="25" cy="150" r="3" fill="white" opacity="0.7"/>
                    </svg>
                </div>

                <h2 class="fw-bold mb-2" style="font-size: 1.65rem;">Join Our Marketplace</h2>
                <p class="mb-3" style="opacity: 0.95; font-size: 0.88rem;">Start buying and selling with ease</p>

                <div>
                    <div class="feature-compact">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <span>Post unlimited ads</span>
                        </div>
                    </div>
                    <div class="feature-compact">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <span>Connect with buyers</span>
                        </div>
                    </div>
                    <div class="feature-compact">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <span>Safe & secure platform</span>
                        </div>
                    </div>
                    <div class="feature-compact">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <span>Easy management</span>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <a href="{{ path('app_login') }}" class="btn btn-light px-4" style="border-radius: 50px; font-weight: 600; font-size: 0.85rem; padding: 8px 18px;">
                        Already a member? Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input && icon) {
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }
}
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Dashboard - Marketplace{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .sidebar {
            width: 250px;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: transform 0.3s ease;
            overflow-y: auto;
        }

        .main-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
        }

        .mobile-toggle {
            display: none;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .sidebar-bottom {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 16px;
            width: 250px;
        }

        .sidebar-content {
            padding-bottom: 80px !important;
        }

        .advert-img {
            width: 50px;
            height: 50px;
            object-fit: cover;
        }

        .stat-card {
            transition: transform 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-2px);
        }

        /* ========================================
           MOBILE RESPONSIVE
           ======================================== */

        /* Tablet (992px and below) */
        @media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
                opacity: 1;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .mobile-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
                position: fixed;
                top: 1rem;
                left: 1rem;
                z-index: 1001;
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 0.5rem;
                padding: 0.5rem 0.75rem;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                cursor: pointer;
            }

            .mobile-toggle:hover {
                background: #f9fafb;
            }

            .mobile-toggle:active {
                transform: scale(0.95);
            }

            .header-user-info {
                display: none !important;
            }
        }

        /* Tablet/Phone (768px and below) */
        @media (max-width: 767.98px) {
            .bg-white.border-bottom.p-4 {
                padding: 1.5rem !important;
            }

            h4 {
                font-size: 1.5rem;
            }

            .stat-card h3 {
                font-size: 1.5rem;
            }

            .stat-card i {
                font-size: 1.6rem !important;
            }

            .card-body.text-center.py-5 i {
                font-size: 3.5rem !important;
            }

            .card-body.text-center.py-5 h4 {
                font-size: 1.5rem;
            }

            .card-header h5 {
                font-size: 1.25rem;
            }

            .table {
                font-size: 0.875rem;
            }

            .advert-img {
                width: 45px;
                height: 45px;
            }
        }

        /* Phone (576px and below) */
        @media (max-width: 575.98px) {
            .mobile-toggle {
                top: 0.75rem;
                left: 0.75rem;
                padding: 0.4rem 0.6rem;
            }

            .mobile-toggle i {
                font-size: 1.3rem;
            }

            .bg-light > .p-4 {
                padding: 1rem !important;
                padding-top: 4rem !important;
            }

            .bg-white.border-bottom.p-4 {
                padding: 1rem !important;
                padding-top: 3.5rem !important;
            }

            .d-flex.justify-content-between.align-items-center {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 0.75rem;
            }

            h4 {
                font-size: 1.3rem;
                margin-bottom: 0.5rem !important;
            }

            .text-muted {
                font-size: 0.85rem;
            }

            /* Stats cards */
            .row.g-4 {
                gap: 0.75rem !important;
            }

            .stat-card .card-body {
                padding: 0.875rem !important;
            }

            .stat-card .d-flex {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 0.75rem;
            }

            .stat-card h3 {
                font-size: 1.3rem;
            }

            .stat-card .text-muted {
                font-size: 0.8rem;
            }

            .stat-card i {
                font-size: 1.4rem !important;
            }

            .stat-card .rounded-3 {
                padding: 0.625rem !important;
            }

            /* Quick action card */
            .card-body.text-center.py-5 {
                padding: 2rem 1rem !important;
            }

            .card-body.text-center i {
                font-size: 3rem !important;
                margin-bottom: 0.75rem !important;
            }

            .card-body.text-center h4 {
                font-size: 1.3rem;
                margin-bottom: 0.75rem;
            }

            .card-body.text-center p {
                font-size: 0.85rem;
                margin-bottom: 1rem !important;
            }

            .btn-lg {
                font-size: 0.9rem !important;
                padding: 0.625rem 1.25rem !important;
            }

            /* Recent adverts card */
            .mb-4 {
                margin-bottom: 1rem !important;
            }

            .card-header {
                padding: 1rem !important;
            }

            .card-header h5 {
                font-size: 1.15rem;
                margin-bottom: 0 !important;
            }

            /* Make table responsive */
            .table-responsive {
                margin: 0;
            }

            .table {
                font-size: 0.8rem;
            }

            .table thead {
                display: none;
            }

            .table tbody tr {
                display: block;
                border: 1px solid #f3f4f6;
                border-radius: 0.5rem;
                margin-bottom: 1rem;
                padding: 1rem;
                background: white;
            }

            .table tbody tr:hover {
                background: #f9fafb;
            }

            .table tbody td {
                display: block;
                text-align: left !important;
                padding: 0.5rem 0 !important;
                border: none !important;
            }

            .table tbody td:first-child {
                padding-top: 0 !important;
                margin-bottom: 0.75rem;
            }

            .table tbody td:last-child {
                padding-bottom: 0 !important;
                margin-top: 0.75rem;
                padding-top: 0.75rem !important;
                border-top: 1px solid #f3f4f6 !important;
            }

            .table tbody td:not(:first-child):not(:last-child)::before {
                content: attr(data-label);
                font-weight: 600;
                display: block;
                margin-bottom: 0.25rem;
                color: #6b7280;
                font-size: 0.75rem;
            }

            .advert-img,
            .bg-light.rounded {
                width: 40px;
                height: 40px;
            }

            .badge {
                font-size: 0.7rem;
            }

            /* Action buttons */
            .table td form {
                display: inline-block !important;
            }

            .table .btn-sm {
                font-size: 0.75rem;
                padding: 0.375rem 0.5rem;
            }

            /* Card footer */
            .card-footer {
                padding: 1rem !important;
                font-size: 0.85rem;
            }

            /* Sidebar adjustments */
            .sidebar {
                width: 280px;
            }

            .sidebar-content {
                padding: 1.25rem !important;
                padding-bottom: 80px !important;
            }

            .sidebar .d-flex.align-items-center {
                margin-bottom: 1rem !important;
            }

            .sidebar .bg-primary.rounded-3 {
                padding: 0.5rem !important;
            }

            .sidebar h5 {
                font-size: 1.1rem;
            }

            .sidebar .nav-link {
                font-size: 0.9rem;
                padding: 0.625rem 0.75rem;
            }

            .sidebar .nav-link i {
                font-size: 0.95rem;
            }

            .sidebar-bottom {
                position: relative;
                padding: 1.25rem !important;
                margin-top: 2rem;
                width: 100%;
            }

            .sidebar-bottom .btn {
                font-size: 0.9rem;
                padding: 0.625rem 0.75rem;
                max-width: 100% !important;
            }
        }

        /* Very Small Phone (400px and below) */
        @media (max-width: 399.98px) {
            .mobile-toggle {
                top: 0.625rem;
                left: 0.625rem;
                padding: 0.375rem 0.55rem;
            }

            .mobile-toggle i {
                font-size: 1.2rem;
            }

            h4 {
                font-size: 1.2rem;
            }

            .stat-card h3 {
                font-size: 1.2rem;
            }

            .stat-card i {
                font-size: 1.3rem !important;
            }

            .card-body.text-center i {
                font-size: 2.5rem !important;
            }

            .card-body.text-center h4 {
                font-size: 1.2rem;
            }

            .btn-lg {
                font-size: 0.85rem !important;
                padding: 0.5rem 1rem !important;
            }

            .card-header h5 {
                font-size: 1.05rem;
            }

            .table {
                font-size: 0.75rem;
            }

            .table tbody tr {
                padding: 0.875rem;
            }

            .advert-img,
            .bg-light.rounded {
                width: 35px;
                height: 35px;
            }

            .table .btn-sm {
                font-size: 0.7rem;
                padding: 0.3rem 0.45rem;
            }

            .card-footer {
                font-size: 0.8rem;
            }

            .sidebar {
                width: 260px;
            }

            .sidebar-content {
                padding: 1rem !important;
                padding-bottom: 80px !important;
            }

            .sidebar h5 {
                font-size: 1rem;
            }

            .sidebar .nav-link {
                font-size: 0.85rem;
                padding: 0.5rem 0.625rem;
            }

            .sidebar-bottom {
                padding: 1rem !important;
            }

            .sidebar-bottom .btn {
                font-size: 0.85rem;
                padding: 0.5rem 0.625rem;
            }
        }

        /* Landscape phones */
        @media (max-height: 500px) and (orientation: landscape) {
            .sidebar {
                max-height: 100vh;
            }

            .sidebar-content {
                padding: 1rem !important;
                padding-bottom: 80px !important;
            }

            .sidebar .d-flex.align-items-center {
                margin-bottom: 0.75rem !important;
            }

            .sidebar .bg-primary.rounded-3 {
                padding: 0.4rem !important;
            }

            .sidebar h5 {
                font-size: 0.95rem;
            }

            .sidebar .nav-link {
                padding: 0.5rem 0.625rem;
            }

            .sidebar-bottom {
                position: relative;
                margin-top: 1rem;
                padding: 1rem !important;
            }
        }

        /* Add data-label attribute styling for mobile */
        @media (max-width: 575.98px) {
            .table tbody td[data-label]::before {
                content: attr(data-label);
            }
        }
    </style>
{% endblock %}

{% block body %}
<!-- Mobile Menu Toggle -->
<button class="mobile-toggle btn" onclick="toggleSidebar()" aria-label="Toggle Menu">
    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
</button>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" onclick="toggleSidebar()"></div>

<div class="d-flex">
    <!-- Sidebar -->
    <div class="bg-white border-end sidebar" id="sidebar">
        <div class="p-4 sidebar-content">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary rounded-3 p-2 me-2">
                    <i class="bi bi-shop text-white"></i>
                </div>
                <h5 class="mb-0 fw-bold">Marketplace</h5>
            </div>

            <nav class="nav flex-column">
                <a class="nav-link active text-primary bg-light rounded mb-2" href="{{ path('app_user_dashboard') }}">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
                <a class="nav-link text-dark" href="{{ path('app_user_adverts') }}">
                    <i class="bi bi-list-ul me-2"></i> My Adverts
                </a>
                <a class="nav-link text-dark" href="{{ path('app_home') }}">
                    <i class="bi bi-house me-2"></i> Marketplace
                </a>
            </nav>
        </div>

        <div class="sidebar-bottom">
            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger" style="width: 100%; max-width: 218px;">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 bg-light main-content">
        <!-- Header -->
        <div class="bg-white border-bottom p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1">Advertisement Management</h4>
                    <p class="text-muted mb-0">Manage your advertisements</p>
                </div>
                <div class="d-flex align-items-center header-user-info">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                        <span class="text-primary fw-bold">{{ user.initials }}</span>
                    </div>
                    <div>
                        <div class="fw-bold">{{ user.fullName }}</div>
                        <small class="text-muted">User</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="p-4">
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1">My Ads</p>
                                    <h3 class="mb-0">{{ advert_count }}</h3>
                                </div>
                                <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                                    <i class="bi bi-megaphone text-primary" style="font-size: 2rem;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Action -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body text-center py-5">
                    <i class="bi bi-plus-circle text-primary mb-3" style="font-size: 4rem;"></i>
                    <h4>Create Your First Advert</h4>
                    <p class="text-muted mb-4">Start selling by creating your first advertisement</p>
                    <a href="{{ path('app_user_advert_create') }}" class="btn btn-primary btn-lg">
                        <i class="bi bi-plus-circle me-2"></i> Create New Advert
                    </a>
                </div>
            </div>

            <!-- Recent Adverts -->
            {% if adverts|length > 0 %}
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">Recent Adverts</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ad Details</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for advert in adverts|slice(0, 5) %}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            {% if advert.image %}
                                                <img src="{{ advert.image|cloudinary_url }}" alt="{{ advert.title }}" class="rounded me-3 advert-img">
                                            {% else %}
                                                <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center advert-img">
                                                    <i class="bi bi-image text-muted"></i>
                                                </div>
                                            {% endif %}
                                            <div>
                                                <div class="fw-bold">{{ advert.title }}</div>
                                                <small class="text-muted">{{ advert.advertId }}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="Category">
                                        <span class="badge bg-primary">{{ advert.category ? advert.category.name : 'N/A' }}</span>
                                    </td>
                                    <td class="fw-bold" data-label="Price">{{ advert.formattedPrice }}</td>
                                    <td data-label="Created">{{ advert.formattedDate }}</td>
                                    <td data-label="Actions">
                                        <a href="{{ path('app_user_advert_edit', {id: advert.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_user_advert_delete', {id: advert.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ advert.id) }}">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <a href="{{ path('app_user_adverts') }}" class="text-primary text-decoration-none">
                        View all adverts <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.querySelector('.sidebar-overlay');
        sidebar.classList.toggle('show');
        overlay.classList.toggle('show');
    }

    // Close sidebar when clicking nav links on mobile
    document.addEventListener('DOMContentLoaded', function() {
        const navLinks = document.querySelectorAll('.sidebar .nav-link');
        navLinks.forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth <= 991.98) {
                    toggleSidebar();
                }
            });
        });

        // Close sidebar on escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.querySelector('.sidebar-overlay');
                if (sidebar.classList.contains('show')) {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('show');
                }
            }
        });
    });
</script>
{% endblock %}

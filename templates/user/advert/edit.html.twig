{% extends 'base.html.twig' %}

{% block title %}Edit Advert - Marketplace{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .sidebar {
            width: 250px;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: transform 0.3s ease;
            overflow-y: auto;
        }

        .main-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
        }

        .mobile-toggle {
            display: none;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .sidebar-bottom {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 16px;
            width: 250px;
        }

        .sidebar-content {
            padding-bottom: 80px;
        }

        .current-image {
            width: 100px;
            height: 100px;
            object-fit: cover;
        }

        /* ========================================
           MOBILE RESPONSIVE
           ======================================== */

        /* Tablet (992px and below) */
        @media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
                opacity: 1;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .mobile-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
                position: fixed;
                top: 1rem;
                left: 1rem;
                z-index: 1001;
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 0.5rem;
                padding: 0.5rem 0.75rem;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                cursor: pointer;
            }

            .mobile-toggle:hover {
                background: #f9fafb;
            }

            .mobile-toggle:active {
                transform: scale(0.95);
            }

            .header-user-info {
                display: none !important;
            }
        }

        /* Tablet/Phone (768px and below) */
        @media (max-width: 767.98px) {
            .bg-white.border-bottom.p-4 {
                padding: 1.5rem !important;
            }

            h4 {
                font-size: 1.5rem;
            }

            .card-body.p-5 {
                padding: 2rem !important;
            }

            h3 {
                font-size: 1.5rem;
            }

            .form-label {
                font-size: 0.9rem;
            }

            .form-control,
            .form-select {
                font-size: 0.9rem;
            }

            .btn {
                font-size: 0.9rem;
            }

            .current-image {
                width: 80px;
                height: 80px;
            }
        }

        /* Phone (576px and below) */
        @media (max-width: 575.98px) {
            .mobile-toggle {
                top: 0.75rem;
                left: 0.75rem;
                padding: 0.4rem 0.6rem;
            }

            .mobile-toggle i {
                font-size: 1.3rem;
            }

            .bg-light > .p-4 {
                padding: 1rem !important;
                padding-top: 4rem !important;
            }

            .bg-white.border-bottom.p-4 {
                padding: 1rem !important;
                padding-top: 3.5rem !important;
            }

            .d-flex.justify-content-between.align-items-center {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 0.75rem;
            }

            h4 {
                font-size: 1.3rem;
                margin-bottom: 0.5rem !important;
            }

            .text-muted {
                font-size: 0.85rem;
            }

            /* Form card */
            .row.justify-content-center {
                margin: 0 !important;
            }

            .col-lg-8 {
                padding: 0 !important;
            }

            .card-body.p-5 {
                padding: 1.5rem !important;
            }

            .text-center.mb-4 {
                margin-bottom: 1.5rem !important;
            }

            .text-center .rounded-circle {
                width: 50px !important;
                height: 50px !important;
                margin-bottom: 0.75rem !important;
            }

            .text-center i {
                font-size: 1.3rem !important;
            }

            h3 {
                font-size: 1.3rem;
            }

            .text-center p {
                font-size: 0.85rem;
            }

            .mb-3 {
                margin-bottom: 1rem !important;
            }

            .mb-4 {
                margin-bottom: 1.25rem !important;
            }

            .form-label {
                font-size: 0.85rem;
                margin-bottom: 0.375rem !important;
            }

            .form-control,
            .form-select {
                font-size: 0.85rem;
                padding: 0.5rem 0.75rem;
            }

            textarea.form-control {
                font-size: 0.85rem !important;
            }

            small {
                font-size: 0.75rem !important;
            }

            /* Current image */
            .current-image {
                width: 70px;
                height: 70px;
            }

            /* Form row */
            .row.g-3 {
                gap: 1rem !important;
            }

            .row.g-3 > div {
                width: 100%;
            }

            /* Buttons */
            .d-flex.gap-3 {
                flex-direction: column;
                gap: 0.75rem !important;
            }

            .btn {
                width: 100% !important;
                font-size: 0.85rem;
                padding: 0.625rem 1rem;
            }

            .btn i {
                font-size: 0.9rem;
            }

            .btn.flex-grow-1 {
                flex-grow: unset !important;
            }

            /* Form errors */
            .invalid-feedback {
                font-size: 0.75rem;
            }

            /* Sidebar adjustments */
            .sidebar {
                width: 280px;
            }

            .sidebar-content {
                padding: 1.25rem !important;
                padding-bottom: 80px !important;
            }

            .sidebar .d-flex.align-items-center {
                margin-bottom: 1rem !important;
            }

            .sidebar .bg-primary.rounded-3 {
                padding: 0.5rem !important;
            }

            .sidebar h5 {
                font-size: 1.1rem;
            }

            .sidebar .nav-link {
                font-size: 0.9rem;
                padding: 0.625rem 0.75rem;
            }

            .sidebar .nav-link i {
                font-size: 0.95rem;
            }

            .sidebar-bottom {
                position: relative;
                padding: 1.25rem !important;
                margin-top: 2rem;
                width: 100%;
            }

            .sidebar-bottom .btn {
                font-size: 0.9rem;
                padding: 0.625rem 0.75rem;
                max-width: 100% !important;
            }
        }

        /* Very Small Phone (400px and below) */
        @media (max-width: 399.98px) {
            .mobile-toggle {
                top: 0.625rem;
                left: 0.625rem;
                padding: 0.375rem 0.55rem;
            }

            .mobile-toggle i {
                font-size: 1.2rem;
            }

            h4 {
                font-size: 1.2rem;
            }

            .card-body.p-5 {
                padding: 1.25rem !important;
            }

            .text-center .rounded-circle {
                width: 45px !important;
                height: 45px !important;
            }

            .text-center i {
                font-size: 1.2rem !important;
            }

            h3 {
                font-size: 1.2rem;
            }

            .form-label {
                font-size: 0.8rem;
            }

            .form-control,
            .form-select {
                font-size: 0.8rem;
                padding: 0.45rem 0.65rem;
            }

            .btn {
                font-size: 0.8rem;
                padding: 0.5rem 0.875rem;
            }

            .current-image {
                width: 60px;
                height: 60px;
            }

            .sidebar {
                width: 260px;
            }

            .sidebar-content {
                padding: 1rem !important;
                padding-bottom: 80px !important;
            }

            .sidebar h5 {
                font-size: 1rem;
            }

            .sidebar .nav-link {
                font-size: 0.85rem;
                padding: 0.5rem 0.625rem;
            }

            .sidebar-bottom {
                padding: 1rem !important;
            }

            .sidebar-bottom .btn {
                font-size: 0.85rem;
                padding: 0.5rem 0.625rem;
            }
        }

        /* Landscape phones */
        @media (max-height: 500px) and (orientation: landscape) {
            .sidebar {
                max-height: 100vh;
            }

            .sidebar-content {
                padding: 1rem !important;
                padding-bottom: 80px !important;
            }

            .sidebar .d-flex.align-items-center {
                margin-bottom: 0.75rem !important;
            }

            .sidebar .bg-primary.rounded-3 {
                padding: 0.4rem !important;
            }

            .sidebar h5 {
                font-size: 0.95rem;
            }

            .sidebar .nav-link {
                padding: 0.5rem 0.625rem;
            }

            .sidebar-bottom {
                position: relative;
                margin-top: 1rem;
                padding: 1rem !important;
            }
        }
    </style>
{% endblock %}

{% block body %}
<!-- Mobile Menu Toggle -->
<button class="mobile-toggle btn" onclick="toggleSidebar()" aria-label="Toggle Menu">
    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
</button>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" onclick="toggleSidebar()"></div>

<div class="d-flex">
    <!-- Sidebar -->
    <div class="bg-white border-end sidebar" id="sidebar">
        <div class="p-4 sidebar-content">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary rounded-3 p-2 me-2">
                    <i class="bi bi-shop text-white"></i>
                </div>
                <h5 class="mb-0 fw-bold">Marketplace</h5>
            </div>

            <nav class="nav flex-column">
                <a class="nav-link text-dark" href="{{ path('app_user_dashboard') }}">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
                <a class="nav-link active text-primary bg-light rounded mb-2" href="{{ path('app_user_adverts') }}">
                    <i class="bi bi-list-ul me-2"></i> My Adverts
                </a>
                <a class="nav-link text-dark" href="{{ path('app_home') }}">
                    <i class="bi bi-house me-2"></i> Marketplace
                </a>
            </nav>
        </div>

        <div class="sidebar-bottom">
            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger" style="width: 100%; max-width: 218px;">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 bg-light main-content">
        <!-- Header -->
        <div class="bg-white border-bottom p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1">Advertisement Management</h4>
                    <p class="text-muted mb-0">Manage your advertisements</p>
                </div>
                <div class="d-flex align-items-center header-user-info">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                        <span class="text-primary fw-bold">{{ app.user.initials }}</span>
                    </div>
                    <div>
                        <div class="fw-bold">{{ app.user.fullName }}</div>
                        <small class="text-muted">User</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="p-4">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-5">
                            <div class="text-center mb-4">
                                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                    <i class="bi bi-pencil text-primary" style="font-size: 1.5rem;"></i>
                                </div>
                                <h3 class="fw-bold">Edit Ad</h3>
                                <p class="text-muted">Update your advertisement details</p>
                            </div>

                            {{ form_start(advertForm) }}

                            <div class="mb-3">
                                {{ form_label(advertForm.category) }}
                                {{ form_widget(advertForm.category) }}
                                {{ form_errors(advertForm.category) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(advertForm.title) }}
                                {{ form_widget(advertForm.title) }}
                                {{ form_errors(advertForm.title) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(advertForm.description) }}
                                {{ form_widget(advertForm.description) }}
                                {{ form_errors(advertForm.description) }}
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    {{ form_label(advertForm.price) }}
                                    {{ form_widget(advertForm.price) }}
                                    {{ form_errors(advertForm.price) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_label(advertForm.location) }}
                                    {{ form_widget(advertForm.location) }}
                                    {{ form_errors(advertForm.location) }}
                                </div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(advertForm.phoneNumber) }}
                                {{ form_widget(advertForm.phoneNumber) }}
                                {{ form_errors(advertForm.phoneNumber) }}
                            </div>

                            {% if advert.image %}
                            <div class="mb-3">
                                <label class="form-label">Current Image</label>
                                <div class="d-flex gap-2 flex-wrap">
                                    <img src="{{ advert.image|cloudinary_url }}" alt="Current" class="rounded current-image">
                                </div>
                            </div>
                            {% endif %}

                            <div class="mb-4">
                                {{ form_label(advertForm.imageFile) }}
                                {{ form_widget(advertForm.imageFile) }}
                                {{ form_errors(advertForm.imageFile) }}
                                <small class="text-muted d-block mt-1">Upload a new image to replace the current one</small>
                            </div>

                            <div class="d-flex gap-3">
                                <button type="submit" class="btn btn-primary flex-grow-1">
                                    <i class="bi bi-check-circle me-2"></i> Save Changes
                                </button>
                                <a href="{{ path('app_user_adverts') }}" class="btn btn-outline-danger">
                                    <i class="bi bi-x-circle me-2"></i> Cancel
                                </a>
                            </div>

                            {{ form_end(advertForm) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.querySelector('.sidebar-overlay');
        sidebar.classList.toggle('show');
        overlay.classList.toggle('show');
    }

    // Close sidebar when clicking nav links on mobile
    document.addEventListener('DOMContentLoaded', function() {
        const navLinks = document.querySelectorAll('.sidebar .nav-link');
        navLinks.forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth <= 991.98) {
                    toggleSidebar();
                }
            });
        });

        // Close sidebar on escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.querySelector('.sidebar-overlay');
                if (sidebar.classList.contains('show')) {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('show');
                }
            }
        });
    });
</script>
{% endblock %}
